@* A card of to-dos with + Add. On a dashboard: the open ones, reminders that are due first, then the soonest due. On a record's page: the ones about it. *@
@implements IDisposable
@inject PortfolioService Svc
@inject TodoEvents Events

<div class="card stack @CssClass" style="@(CssClass is null ? "margin-top:1rem" : null)">
    <div class="row">
        <h2 style="margin:0">@Title</h2>
        @if (Dashboard && todos is not null && todos.Count(t => TodoRules.NeedsReminder(t, today)) is > 0 and var due)
        {
            <span class="badge todo-count @(todos.Any(t => TodoRules.IsOverdue(t, today)) ? "late" : "")" title="Reminders due, overdue included">@due reminder@(due == 1 ? "" : "s") due</span>
        }
        <span class="spacer"></span>
        @if (!Dashboard)
        {
            <label class="check small"><input type="checkbox" checked="@showDone" @onchange="ToggleDoneAsync" /> Show done</label>
        }
        <a class="small" href="/todo">All to-dos →</a>
        <button type="button" class="btn" @onclick="New">+ Add</button>
    </div>
    @if (todos is null)
    {
        <div class="muted small">Loading…</div>
    }
    else if (todos.Count == 0)
    {
        <div class="muted small">@(Dashboard && Name is null ? "Nothing on your to-do list. You're all caught up." : $"No open to-dos{(Name is null ? "" : $" for {Name}")}.")</div>
    }
    else
    {
        <TodoRows Todos="Shown" Today="today" ShowLink="Link is null" OnEdit="Edit" OnChanged="ReloadAndNotifyAsync" />
        @if (todos.Count > Shown.Count)
        {
            <a class="small" href="/todo">+ @(todos.Count - Shown.Count) more on the To-do page</a>
        }
    }
</div>

@if (editing is not null)
{
    <TodoEditor Draft="editing" Original="editingTodo" OnClose="OnClosed" />
}

@code {
    [Parameter] public string Title { get; set; } = "To-do";
    /// <summary>Only to-dos about this record; new ones are linked to it.</summary>
    [Parameter] public TodoLink? Link { get; set; }
    /// <summary>Only to-dos about this product (or one of its roadmap items).</summary>
    [Parameter] public int? ProductId { get; set; }
    /// <summary>
    /// For a dashboard: open to-dos only, reminders that are due first (<see cref="TodoRules.ForDashboard"/>), at most
    /// <see cref="Max"/>.
    /// </summary>
    [Parameter] public bool Dashboard { get; set; }
    [Parameter] public int Max { get; set; } = 8;
    /// <summary>The record's or product's name, for the empty message.</summary>
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? CssClass { get; set; }

    private List<TodoItem>? todos;
    private TodoDraft? editing;
    private TodoItem? editingTodo;
    private bool showDone;
    private DateOnly today;

    private List<TodoItem> Shown => Dashboard ? (todos ?? []).Take(Max).ToList() : todos ?? [];

    protected override void OnInitialized() => Events.Changed += OnEvent;
    public void Dispose() => Events.Changed -= OnEvent;

    private void OnEvent() => _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        today = DateOnly.FromDateTime(DateTime.Today);
        todos = Dashboard
            ? TodoRules.ForDashboard(await Svc.GetTodosAsync(new TodoQuery { ProductId = ProductId }), today).ToList()
            : await Svc.GetTodosAsync(new TodoQuery { Link = Link, ProductId = Link is null ? ProductId : null, IncludeDone = showDone });
    }

    private async Task ToggleDoneAsync(ChangeEventArgs e)
    {
        showDone = e.Value is true;
        await LoadAsync();
    }

    private void New()
    {
        editingTodo = null;
        editing = TodoDraft.New(Link ?? (ProductId is { } pid ? new TodoLink(TodoLinkKind.Product, pid) : null));
    }

    private void Edit(TodoItem t)
    {
        editingTodo = t;
        editing = TodoDraft.From(t);
    }

    private async Task OnClosed(bool changed)
    {
        editing = null;
        if (changed) await LoadAsync(); // the editor also tells everyone else
    }

    private async Task ReloadAndNotifyAsync()
    {
        await LoadAsync();
        Events.Notify();
    }
}
