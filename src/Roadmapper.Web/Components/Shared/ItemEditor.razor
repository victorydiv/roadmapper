@inject RoadmapService Svc
@inject PortfolioService Portfolio

<div class="modal-backdrop">
    <div class="modal">
        <EditForm Model="draft" OnValidSubmit="SaveAsync">
            <div class="modal-head">
                <TypeBadge Type="draft.ItemType" />
                <h2>@(draft.IsNew ? $"New {draft.ItemType}" : "Edit item")</h2>
                <span class="spacer"></span>
                <button type="button" class="btn icon" title="Close" @onclick="() => CloseAsync()">✕</button>
            </div>

            <div class="modal-body">
                @if (error is not null)
                {
                    <div class="alert">@error</div>
                }

                <label class="field">Title
                    <InputText @bind-Value="draft.Title" autofocus />
                </label>
                @if (draft.SourceTemplateName is { } source)
                {
                    <div class="muted small" title="For reference only; editing the template doesn't change this task">
                        Created from template <b>@source</b>@(draft.SourceTemplateAppliedAt is { } at ? $" on {at.ToLocalTime():MMM d, yyyy}" : "")
                    </div>
                }

                <div class="grid-2">
                    @if (draft.IsNew)
                    {
                        <label class="field">Type
                            <InputSelect @bind-Value="draft.ItemType" @bind-Value:after="OnTypeChanged">
                                @foreach (var t in Enum.GetValues<ItemType>())
                                {
                                    <option value="@t">@t</option>
                                }
                            </InputSelect>
                        </label>
                    }
                    @if (parentType is { } pt)
                    {
                        <label class="field">Parent @pt
                            <InputSelect @bind-Value="draft.ParentId">
                                <option value="">— choose a @pt.ToString().ToLower() —</option>
                                @foreach (var p in roadmap.Items.Where(i => i.ItemType == pt).OrderBy(i => roadmap.PathOf(i)).ThenBy(i => i.Title))
                                {
                                    <option value="@p.Id">@Display(p)</option>
                                }
                            </InputSelect>
                        </label>
                    }
                </div>

                <label class="field">Description
                    <InputTextArea @bind-Value="draft.Description" />
                </label>

                <fieldset>
                    <legend>Status &amp; schedule</legend>
                    <div class="grid-3">
                        <label class="field">Status
                            <InputSelect @bind-Value="draft.Status">
                                @foreach (var s in Enum.GetValues<ItemStatus>())
                                {
                                    <option value="@s">@Ui.Label(s)</option>
                                }
                            </InputSelect>
                        </label>
                        <label class="field">Horizon
                            <InputSelect @bind-Value="draft.Horizon">
                                <option value="">Unassigned</option>
                                @foreach (var h in Enum.GetValues<Horizon>())
                                {
                                    <option value="@h">@h</option>
                                }
                            </InputSelect>
                        </label>
                        <label class="field">Progress % @(RolledUp ? "(rolled up)" : "")
                            <InputNumber @bind-Value="draft.ProgressPct" min="0" max="100" disabled="@(RolledUp || draft.Status == ItemStatus.Done)" />
                        </label>
                        <label class="field">Start @(RolledUp ? "(rolled up)" : "")
                            <InputDate @bind-Value="draft.StartDate" disabled="@RolledUp" />
                        </label>
                        <label class="field">End @(RolledUp ? "(rolled up)" : "")
                            <InputDate @bind-Value="draft.EndDate" disabled="@RolledUp" />
                        </label>
                        <label class="field">Owner
                            <InputText @bind-Value="draft.Owner" />
                        </label>
                    </div>
                    @if (HasChildren)
                    {
                        <label class="check">
                            <InputCheckbox @bind-Value="draft.IsRollupOverridden" />
                            Set dates and progress manually instead of rolling them up from children
                        </label>
                    }
                </fieldset>

                <fieldset>
                    <legend>Priority: @strategy.DisplayName</legend>
                    @switch (roadmap.Product.ScoringModel)
                    {
                        case ScoringModel.Rice:
                            <div class="grid-4">
                                <label class="field" title="People or events affected per period">Reach
                                    <InputNumber @bind-Value="draft.Score.Reach" min="0" />
                                </label>
                                <label class="field" title="3 = massive, 2 = high, 1 = medium, 0.5 = low, 0.25 = minimal">Impact (0.25–3)
                                    <InputNumber @bind-Value="draft.Score.Impact" min="0" step="0.25" />
                                </label>
                                <label class="field" title="100 = high, 80 = medium, 50 = low">Confidence %
                                    <InputNumber @bind-Value="draft.Score.Confidence" min="0" max="100" />
                                </label>
                                <label class="field" title="Person-months">Effort
                                    <InputNumber @bind-Value="draft.Score.Effort" min="0" step="0.5" />
                                </label>
                            </div>
                            break;
                        case ScoringModel.Wsjf when !roadmap.Rubric.IsEmpty:
                            var results = RubricResults;
                            <div class="rubric-factors">
                                @foreach (var r in results)
                                {
                                    var factor = r.Factor;
                                    var calculates = roadmap.Rubric.Calculates(factor);
                                    var manual = !calculates || draft.Score.ManualFactors.HasFlag(RubricCalculator.Flag(factor));
                                    <div class="rubric-factor">
                                        <div class="row">
                                            <b>@RubricText.Factor(factor)</b>
                                            <span class="spacer"></span>
                                            @if (manual)
                                            {
                                                <input type="number" min="0" step="any" class="factor-input" value="@FactorText(factor)"
                                                       @onchange="e => SetFactor(factor, e.Value as string)" />
                                                @if (calculates)
                                                {
                                                    <button type="button" class="btn sm" title="Work this factor out from the answers below" @onclick="() => SetManual(factor, false, r)">Use rubric</button>
                                                }
                                            }
                                            else
                                            {
                                                <b class="factor-value" title="Calculated from the rubric">@((r.Value ?? RubricCalculator.Get(draft.Score, factor)) is { } v ? RubricText.Number(v) : "–")</b>
                                                <button type="button" class="btn sm" title="Type this factor instead of calculating it" @onclick="() => SetManual(factor, true, r)">Enter by hand</button>
                                            }
                                        </div>
                                        @if (calculates)
                                        {
                                            <div class="rubric-criteria @(manual ? "faded" : "")">
                                                @foreach (var c in roadmap.Rubric.ForFactor(factor))
                                                {
                                                    <label class="field" title="@c.Help">@c.Name@(c.Role == CriterionRole.Adjuster ? " (adjuster)" : "")
                                                        <RubricAnswerInput Criterion="c" Answer="draft.Answers.GetValueOrDefault(c.Id)" StartDate="draft.StartDate"
                                                                           AnswerChanged="a => SetAnswer(c.Id, a)" />
                                                    </label>
                                                }
                                            </div>
                                            @if (manual)
                                            {
                                                <div class="muted small">Entered by hand@(r.Value is { } rv ? $"; the rubric would give {RubricText.Number(rv)}" : "").</div>
                                            }
                                            else if (!r.Calculated)
                                            {
                                                <div class="muted small">@(RubricCalculator.Get(draft.Score, factor) is null
                                                    ? "Answer the criteria above to calculate this."
                                                    : "Not answered yet, so it keeps its current value.")</div>
                                            }
                                            else if (r.Criteria.Count(x => x.Answered) > 1)
                                            {
                                                @* A single answer explains itself next to its input; show the working only when several combine. *@
                                                <div class="muted small">@r.Explanation</div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                            break;
                        case ScoringModel.Wsjf:
                            <div class="grid-4">
                                <label class="field">Business value
                                    <InputNumber @bind-Value="draft.Score.BusinessValue" min="0" />
                                </label>
                                <label class="field">Time criticality
                                    <InputNumber @bind-Value="draft.Score.TimeCriticality" min="0" />
                                </label>
                                <label class="field">Risk reduction
                                    <InputNumber @bind-Value="draft.Score.RiskReduction" min="0" />
                                </label>
                                <label class="field">Job size
                                    <InputNumber @bind-Value="draft.Score.JobSize" min="0" />
                                </label>
                            </div>
                            break;
                        case ScoringModel.Moscow:
                            <div class="grid-2">
                                <label class="field">Priority
                                    <InputSelect @bind-Value="draft.Score.Moscow">
                                        <option value="">Not set</option>
                                        @foreach (var m in Enum.GetValues<MoscowPriority>().Reverse())
                                        {
                                            <option value="@m">@Ui.Label(m)</option>
                                        }
                                    </InputSelect>
                                </label>
                                <label class="field" title="Only used to place the item on the prioritization matrix">Effort (for the matrix)
                                    <InputNumber @bind-Value="draft.Score.Effort" min="0" step="0.5" />
                                </label>
                            </div>
                            break;
                    }
                    <div class="row">
                        <span class="muted small">Score: <b>@PreviewScore</b></span>
                        <span class="spacer"></span>
                        <label class="field" style="flex-direction:row;align-items:center;gap:.5rem" title="Pins this item ahead of computed scores (1 = top)">
                            Manual rank
                            <InputNumber @bind-Value="draft.ManualRank" min="1" style="width:6rem" />
                        </label>
                    </div>
                </fieldset>

                <fieldset>
                    <legend>Classification</legend>
                    <label class="field">Theme
                        <InputSelect @bind-Value="draft.ThemeId">
                            <option value="">None</option>
                            @foreach (var t in roadmap.Product.Themes)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </InputSelect>
                    </label>
                    @if (roadmap.Product.Tags.Count > 0)
                    {
                        <div class="row">
                            @foreach (var tag in roadmap.Product.Tags)
                            {
                                <label class="check">
                                    <input type="checkbox" checked="@draft.TagIds.Contains(tag.Id)" @onchange="e => ToggleTag(tag.Id, (bool)e.Value!)" />
                                    @tag.Name
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="muted small">No tags yet. Add them in Settings.</span>
                    }
                </fieldset>

                @if (!draft.IsNew)
                {
                    @if (draft.ItemType == ItemType.Feature)
                    {
                        var tasks = roadmap.ChildrenOf(draft.Id).ToList();
                        var batches = tasks.Where(t => t.TemplateBatchId is not null).GroupBy(t => t.TemplateBatchId!)
                            .OrderByDescending(g => g.Max(t => t.SourceTemplateAppliedAt)).ToList();
                        <fieldset>
                            <legend>Tasks</legend>
                            <div class="row">
                                <span class="muted small">@tasks.Count task@(tasks.Count == 1 ? "" : "s")</span>
                                <span class="spacer"></span>
                                <button type="button" class="btn sm" @onclick="AddTask">+ Add task</button>
                                <button type="button" class="btn sm" @onclick="() => picking = true">Add from template…</button>
                                <button type="button" class="btn sm" disabled="@(tasks.Count == 0)" @onclick="() => savingTemplate = TemplateRules.FromFeature(roadmap.Find(draft.Id)!, tasks)">
                                    Save tasks as template…
                                </button>
                            </div>
                            @if (notice is not null)
                            {
                                <div class="alert ok small">@notice</div>
                            }
                            @if (batches.Count > 0)
                            {
                                <div class="muted small">Added from templates:</div>
                                <ul class="dep-list">
                                    @foreach (var b in batches)
                                    {
                                        var first = b.First();
                                        var edited = b.Count(t => t.UpdatedAt > t.CreatedAt);
                                        <li>
                                            <span class="small">
                                                @b.Count() task@(b.Count() == 1 ? "" : "s") from “@first.SourceTemplateName”
                                                on @first.SourceTemplateAppliedAt?.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                            </span>
                                            <span class="spacer"></span>
                                            @if (confirmingUndo == b.Key)
                                            {
                                                <span class="small overdue">@edited of these @(edited == 1 ? "was" : "were") edited since. Remove anyway?</span>
                                                <button type="button" class="btn danger sm" @onclick="() => UndoBatchAsync(b.Key)">Remove @b.Count()</button>
                                                <button type="button" class="btn sm" @onclick="() => confirmingUndo = null">Keep</button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn sm" title="Remove every task from this application"
                                                        @onclick="async () => { if (edited > 0) confirmingUndo = b.Key; else await UndoBatchAsync(b.Key); }">Undo</button>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </fieldset>
                    }

                    <fieldset>
                        <legend>Dependencies</legend>
                        @{ var blockedBy = roadmap.BlockedBy(draft.Id).ToList(); var blocks = roadmap.Blocks(draft.Id).ToList(); }
                        @if (blockedBy.Count + blocks.Count == 0)
                        {
                            <span class="muted small">No dependencies.</span>
                        }
                        <ul class="dep-list">
                            @foreach (var d in blockedBy)
                            {
                                <li>
                                    <span class="badge blocked">blocked by</span>
                                    @Display(roadmap.Find(d.PredecessorId))
                                    @if (roadmap.HasScheduleConflict(d))
                                    {
                                        <span class="badge blocked" title="This item starts before its predecessor ends">⚠ schedule overlap</span>
                                    }
                                    <span class="spacer"></span>
                                    <button type="button" class="btn sm" @onclick="() => RemoveDependencyAsync(d.Id)">Remove</button>
                                </li>
                            }
                            @foreach (var d in blocks)
                            {
                                <li>
                                    <span class="badge tag">blocks</span>
                                    @Display(roadmap.Find(d.SuccessorId))
                                    @if (roadmap.HasScheduleConflict(d))
                                    {
                                        <span class="badge blocked" title="The successor starts before this item ends">⚠ schedule overlap</span>
                                    }
                                    <span class="spacer"></span>
                                    <button type="button" class="btn sm" @onclick="() => RemoveDependencyAsync(d.Id)">Remove</button>
                                </li>
                            }
                        </ul>
                        <div class="row">
                            <select @bind="newDepDirection" style="width:auto">
                                <option value="blockedBy">This is blocked by</option>
                                <option value="blocks">This blocks</option>
                            </select>
                            <select @bind="newDepItemId" style="flex:1;width:auto">
                                <option value="0">— choose an item —</option>
                                @foreach (var i in roadmap.Items.Where(i => i.Id != draft.Id).OrderBy(i => i.ItemType).ThenBy(i => i.Title))
                                {
                                    <option value="@i.Id">@i.ItemType: @Display(i)</option>
                                }
                            </select>
                            <button type="button" class="btn" disabled="@(newDepItemId == 0)" @onclick="AddDependencyAsync">Add</button>
                        </div>
                    </fieldset>

                    <fieldset>
                        <legend>Applications</legend>
                        @if (appLinks is null)
                        {
                            <span class="muted small">Loading…</span>
                        }
                        else
                        {
                            @if (appLinks.Count == 0)
                            {
                                <span class="muted small">Not linked to any application. Link the systems this @draft.ItemType.ToString().ToLower() changes, so impact and value show up in the portfolio.</span>
                            }
                            <ul class="dep-list">
                                @foreach (var l in appLinks)
                                {
                                    <li>
                                        <span class="badge tag">@PortfolioText.Label(l.ImpactType)</span>
                                        <a href="/portfolio/applications/@l.ApplicationId">@l.Application?.Name</a>
                                        <span class="spacer"></span>
                                        <button type="button" class="btn sm" @onclick="() => UnlinkAppAsync(l.ApplicationId)">Remove</button>
                                    </li>
                                }
                            </ul>
                            @if (allApps.Count > 0)
                            {
                                <div class="row">
                                    <select @bind="newAppImpact" style="width:auto">
                                        @foreach (var i in Enum.GetValues<InitiativeImpact>())
                                        {
                                            <option value="@i">@PortfolioText.Label(i)</option>
                                        }
                                    </select>
                                    <select @bind="newAppId" style="flex:1;width:auto">
                                        <option value="0">— choose an application —</option>
                                        @foreach (var a in allApps.Where(a => appLinks.All(l => l.ApplicationId != a.Id)))
                                        {
                                            <option value="@a.Id">@a.Name</option>
                                        }
                                    </select>
                                    <button type="button" class="btn" disabled="@(newAppId == 0)" @onclick="LinkAppAsync">Add</button>
                                </div>
                            }
                            else
                            {
                                <span class="muted small">Add applications under <a href="/portfolio/applications">Portfolio</a> to link them here.</span>
                            }
                        }
                    </fieldset>

                    <fieldset>
                        <legend>History</legend>
                        @if (history is null)
                        {
                            <div><button type="button" class="btn sm" @onclick="LoadHistoryAsync">Show change history</button></div>
                        }
                        else
                        {
                            <ActivityList Entries="history" />
                        }
                    </fieldset>
                }
            </div>

            <div class="modal-foot">
                @if (!draft.IsNew)
                {
                    @if (confirmingDelete)
                    {
                        <button type="button" class="btn danger" @onclick="DeleteAsync">
                            Confirm delete@(DescendantCount > 0 ? $" (+{DescendantCount} child items)" : "")
                        </button>
                        <button type="button" class="btn" @onclick="() => confirmingDelete = false">Keep</button>
                    }
                    else
                    {
                        <button type="button" class="btn danger" @onclick="() => confirmingDelete = true">Delete</button>
                    }
                }
                <span class="spacer"></span>
                <button type="button" class="btn" @onclick="() => CloseAsync()">Cancel</button>
                <button type="submit" class="btn primary" disabled="@saving">@(draft.IsNew ? "Create" : "Save")</button>
            </div>
        </EditForm>
    </div>
</div>

@if (picking)
{
    <TemplatePicker Roadmap="roadmap" FeatureIds="[draft.Id]" OnClose="OnPickerClosed" />
}

@if (savingTemplate is not null)
{
    <TemplateEditor Roadmap="roadmap" Draft="savingTemplate" Title="Save tasks as template" OnClose="OnSaveTemplateClosed" />
}

@code {
    [Parameter, EditorRequired] public ProductRoadmap Roadmap { get; set; } = default!;
    [Parameter, EditorRequired] public ItemDraft Draft { get; set; } = default!;
    /// <summary>Invoked with true when anything was persisted, so the host page reloads.</summary>
    [Parameter] public EventCallback<bool> OnClose { get; set; }

    // Local copy so dependency edits show immediately without the host re-rendering us.
    private ProductRoadmap roadmap = default!;
    private string? error;
    private bool saving, confirmingDelete, changed;
    private string newDepDirection = "blockedBy";
    private int newDepItemId;
    private List<AuditEntry>? history;
    // The item being edited. Starts as the host's Draft; "Add task" on a Feature switches it to a new task.
    private ItemDraft draft = default!;
    private bool picking;
    private TemplateDraft? savingTemplate;
    private string? notice, confirmingUndo;

    private IScoringStrategy strategy => roadmap.Strategy;
    private ItemType? parentType => HierarchyRules.ParentTypeOf(draft.ItemType);
    private bool HasChildren => !draft.IsNew && roadmap.HasChildren(draft.Id);
    private bool RolledUp => HasChildren && !draft.IsRollupOverridden;
    private string PreviewScore => strategy.Compute(PreviewInputs) is { } s
        ? roadmap.Product.ScoringModel == ScoringModel.Moscow ? Ui.Label((MoscowPriority)(int)s) : s.ToString("0.##")
        : "not enough inputs";
    private int DescendantCount => Descendants(draft.Id);

    private bool UsesRubric => roadmap.Product.ScoringModel == ScoringModel.Wsjf && !roadmap.Rubric.IsEmpty;
    private IReadOnlyList<FactorResult> RubricResults =>
        RubricCalculator.Evaluate(roadmap.Rubric, draft.Answers, draft.StartDate, DateOnly.FromDateTime(DateTime.Today));

    /// <summary>The scoring inputs as they'll be after saving, with the rubric's calculated factors filled in.</summary>
    private ItemScore PreviewInputs
    {
        get
        {
            if (!UsesRubric) return draft.Score;
            var preview = ItemDraft.CopyScore(draft.Score);
            RubricCalculator.Apply(preview, RubricResults);
            return preview;
        }
    }

    private string FactorText(WsjfFactor f) =>
        RubricCalculator.Get(draft.Score, f) is { } v ? v.ToString(System.Globalization.CultureInfo.InvariantCulture) : "";

    private void SetFactor(WsjfFactor f, string? text) =>
        RubricCalculator.Set(draft.Score, f,
            double.TryParse(text, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : null);

    private void SetAnswer(int criterionId, RubricAnswer? answer)
    {
        if (answer is null) draft.Answers.Remove(criterionId);
        else draft.Answers[criterionId] = answer;
    }

    /// <summary>Switching to "by hand" starts from the calculated value, so nothing jumps.</summary>
    private void SetManual(WsjfFactor f, bool manual, FactorResult result)
    {
        var flag = RubricCalculator.Flag(f);
        if (manual)
        {
            if (result.Value is { } v) RubricCalculator.Set(draft.Score, f, v);
            draft.Score.ManualFactors |= flag;
        }
        else draft.Score.ManualFactors &= ~flag;
    }

    protected override async Task OnInitializedAsync()
    {
        roadmap = Roadmap;
        draft = Draft;
        await LoadAppLinksAsync();
    }

    // ---- Application links (portfolio) ----
    private List<ApplicationInitiative>? appLinks;
    private List<Application> allApps = [];
    private int newAppId;
    private InitiativeImpact newAppImpact = InitiativeImpact.Enhances;

    private async Task LoadAppLinksAsync()
    {
        if (draft.IsNew) { appLinks = []; return; }
        appLinks = await Portfolio.GetLinksForItemAsync(draft.Id);
        if (allApps.Count == 0) allApps = await Portfolio.GetApplicationsAsync();
    }

    private async Task LinkAppAsync()
    {
        error = null;
        try
        {
            await Portfolio.LinkItemAsync(newAppId, draft.Id, newAppImpact);
            newAppId = 0;
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        await LoadAppLinksAsync();
    }

    private async Task UnlinkAppAsync(int applicationId)
    {
        await Portfolio.UnlinkItemAsync(applicationId, draft.Id);
        await LoadAppLinksAsync();
    }

    /// <summary>Switches this editor to a new task under the Feature being edited (unsaved Feature edits are dropped).</summary>
    private void AddTask()
    {
        draft = ItemDraft.New(draft.ProductId, ItemType.Task, draft.Id);
        history = null;
        appLinks = [];
        error = notice = null;
        confirmingDelete = false;
    }

    private async Task OnPickerClosed(TemplateBatch? batch)
    {
        picking = false;
        if (batch is null) return;
        notice = $"Added {batch.TaskCount} task{(batch.TaskCount == 1 ? "" : "s")} from “{batch.TemplateName}”. Undo is below.";
        await RefreshAsync();
    }

    private void OnSaveTemplateClosed(bool saved)
    {
        savingTemplate = null;
        if (saved) notice = "Template saved. Manage it under Settings → Task templates.";
    }

    private async Task UndoBatchAsync(string batchId)
    {
        confirmingUndo = null;
        var removed = await Svc.UndoTemplateBatchAsync(batchId);
        notice = $"Removed {removed} task{(removed == 1 ? "" : "s")}.";
        await RefreshAsync();
    }

    private int Descendants(int id) => roadmap.ChildrenOf(id).Sum(c => 1 + Descendants(c.Id));

    private string Display(RoadmapItem? i)
    {
        if (i is null) return "(deleted)";
        var path = roadmap.PathOf(i);
        return path.Length == 0 ? i.Title : $"{path} › {i.Title}";
    }

    private void OnTypeChanged()
    {
        // The previous parent can't be valid for a different type.
        if (draft.ParentId is { } pid && roadmap.Find(pid)?.ItemType != parentType) draft.ParentId = null;
    }

    private void ToggleTag(int id, bool on)
    {
        if (on) draft.TagIds.Add(id); else draft.TagIds.Remove(id);
    }

    private async Task SaveAsync()
    {
        saving = true;
        error = null;
        try
        {
            await Svc.SaveItemAsync(draft);
            changed = true;
            await CloseAsync();
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        finally { saving = false; }
    }

    private async Task DeleteAsync()
    {
        await Svc.DeleteItemAsync(draft.Id);
        changed = true;
        await CloseAsync();
    }

    private async Task AddDependencyAsync()
    {
        error = null;
        try
        {
            if (newDepDirection == "blocks") await Svc.AddDependencyAsync(draft.Id, newDepItemId);
            else await Svc.AddDependencyAsync(newDepItemId, draft.Id);
            newDepItemId = 0;
            await RefreshAsync();
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }

    private async Task RemoveDependencyAsync(int dependencyId)
    {
        await Svc.RemoveDependencyAsync(dependencyId);
        await RefreshAsync();
    }

    private async Task LoadHistoryAsync() =>
        history = await Svc.GetActivityAsync(roadmap.Product.Id, draft.Id, take: 100);

    private async Task RefreshAsync()
    {
        changed = true;
        roadmap = await Svc.GetRoadmapAsync(roadmap.Product.Id) ?? roadmap;
        if (history is not null) await LoadHistoryAsync();
    }

    private Task CloseAsync() => OnClose.InvokeAsync(changed);
}
