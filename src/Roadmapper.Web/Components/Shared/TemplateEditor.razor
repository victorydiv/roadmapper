@inject RoadmapService Svc

@* Create or edit a task template. Also used by "Save tasks as template", which passes a prefilled new draft. *@
<div class="modal-backdrop">
    <div class="modal wide">
        <div class="modal-head">
            <h2>@(Title ?? (Draft.IsNew ? "New task template" : "Edit task template"))</h2>
            <span class="spacer"></span>
            <button type="button" class="btn icon" title="Close" @onclick="() => OnClose.InvokeAsync(false)">✕</button>
        </div>

        <div class="modal-body">
            @if (error is not null)
            {
                <div class="alert">@error</div>
            }

            <div class="grid-2">
                <label class="field">Name
                    <input @bind="Draft.Name" @bind:event="oninput" maxlength="@TemplateRules.MaxNameLength" autofocus />
                </label>
                <label class="field">Description (optional)
                    <input @bind="Draft.Description" />
                </label>
            </div>

            <fieldset>
                <legend>Tasks, in the order they'll be created</legend>
                <div class="muted small">
                    When the Feature has a start date, tasks are scheduled one after another: the first starts on the Feature's
                    start date, and each later task starts the day after the previous one ends. <i>Gap</i> adds days before a task
                    starts (blank = 0, negative = overlap); <i>duration</i> is how many days it lasts, counting the start day
                    (blank = no end date, and the next task starts the same day). Dates can be changed when applying.
                </div>
                <div class="tpl-lines">
                    <div class="tpl-line head">
                        <span></span><span>#</span><span>Title</span><span>Owner</span>
                        <span title="Extra days before this task starts, after the previous task ends (first task: after the Feature starts)">Gap</span><span title="Days long, counting the start day">Duration</span>
                        <span></span>
                    </div>
                    @for (var i = 0; i < Draft.Lines.Count; i++)
                    {
                        var index = i;
                        var line = Draft.Lines[i];
                        <div class="tpl-line @(dragIndex == index ? "dragging" : "") @(overIndex == index && dragIndex != index ? "drop-target" : "")" @key="line.Key"
                             @ondragenter="() => overIndex = index" @ondragover:preventDefault @ondrop="() => Drop(index)">
                            <span class="grip" draggable="true" title="Drag to reorder"
                                  @ondragstart="() => dragIndex = index" @ondragend="() => { dragIndex = null; overIndex = null; }">⠿</span>
                            <span class="num muted">@(index + 1)</span>
                            <input @bind="line.Title" placeholder="Task title" maxlength="@TemplateRules.MaxTitleLength" />
                            <input @bind="line.Owner" placeholder="Owner" />
                            <input type="number" @bind="line.StartOffsetDays" placeholder="0" title="Extra days before this task starts, after the previous task ends (first task: after the Feature starts)" />
                            <input type="number" @bind="line.DurationDays" min="1" placeholder="—" title="Days long, counting the start day" />
                            <span class="row" style="gap:.1rem;flex-wrap:nowrap">
                                <button type="button" class="btn icon" title="Move up" disabled="@(index == 0)" @onclick="() => Move(index, -1)">↑</button>
                                <button type="button" class="btn icon" title="Move down" disabled="@(index == Draft.Lines.Count - 1)" @onclick="() => Move(index, 1)">↓</button>
                                <button type="button" class="btn icon" title="Description and tags" @onclick="() => Toggle(line.Key)">@(expanded.Contains(line.Key) ? "▴" : "▾")</button>
                                <button type="button" class="btn icon" title="Remove task" @onclick="() => Draft.Lines.RemoveAt(index)">✕</button>
                            </span>
                            @if (expanded.Contains(line.Key))
                            {
                                <div class="tpl-details">
                                    <label class="field">Description
                                        <textarea @bind="line.Description" rows="2"></textarea>
                                    </label>
                                    @if (Roadmap.Product.Tags.Count > 0)
                                    {
                                        <div class="row">
                                            <span class="muted small">Tags:</span>
                                            @foreach (var tag in Roadmap.Product.Tags)
                                            {
                                                <label class="check">
                                                    <input type="checkbox" checked="@line.TagIds.Contains(tag.Id)"
                                                           @onchange="e => { if ((bool)e.Value!) line.TagIds.Add(tag.Id); else line.TagIds.Remove(tag.Id); }" />
                                                    @tag.Name
                                                </label>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="muted small">No tags yet. Add them in Settings.</span>
                                    }
                                </div>
                            }
                            else if (Summary(line) is { Length: > 0 } summary)
                            {
                                <div class="tpl-details muted small">@summary</div>
                            }
                        </div>
                    }
                </div>
                <div><button type="button" class="btn" @onclick="AddLine">+ Add task</button></div>
            </fieldset>
        </div>

        <div class="modal-foot">
            <span class="muted small">@Draft.Lines.Count task@(Draft.Lines.Count == 1 ? "" : "s")</span>
            <span class="spacer"></span>
            <button type="button" class="btn" @onclick="() => OnClose.InvokeAsync(false)">Cancel</button>
            <button type="button" class="btn primary" disabled="@saving" @onclick="SaveAsync">Save template</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProductRoadmap Roadmap { get; set; } = default!;
    [Parameter, EditorRequired] public TemplateDraft Draft { get; set; } = default!;
    [Parameter] public string? Title { get; set; }
    /// <summary>Invoked with true when the template was saved.</summary>
    [Parameter] public EventCallback<bool> OnClose { get; set; }

    private readonly HashSet<Guid> expanded = new();
    private int? dragIndex, overIndex;
    private string? error;
    private bool saving;

    private void AddLine()
    {
        Draft.Lines.Add(new TemplateLineDraft());
    }

    private void Move(int index, int direction)
    {
        var target = index + direction;
        if (target < 0 || target >= Draft.Lines.Count) return;
        (Draft.Lines[index], Draft.Lines[target]) = (Draft.Lines[target], Draft.Lines[index]);
    }

    /// <summary>Moves the dragged line into the dropped-on line's position.</summary>
    private void Drop(int target)
    {
        if (dragIndex is { } from && from != target)
        {
            var line = Draft.Lines[from];
            Draft.Lines.RemoveAt(from);
            Draft.Lines.Insert(target, line);
        }
        dragIndex = overIndex = null;
    }

    private void Toggle(Guid key)
    {
        if (!expanded.Remove(key)) expanded.Add(key);
    }

    private string Summary(TemplateLineDraft line)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(line.Description)) parts.Add(line.Description.Length > 80 ? line.Description[..79] + "…" : line.Description);
        parts.AddRange(Roadmap.Product.Tags.Where(t => line.TagIds.Contains(t.Id)).Select(t => "#" + t.Name));
        return string.Join("  ", parts);
    }

    private async Task SaveAsync()
    {
        saving = true;
        error = null;
        try
        {
            await Svc.SaveTemplateAsync(Draft);
            await OnClose.InvokeAsync(true);
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        finally { saving = false; }
    }
}
