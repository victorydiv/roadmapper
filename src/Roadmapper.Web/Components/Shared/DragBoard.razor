@typeparam TKey

@* Columns of item cards; dragging a card to another column invokes OnMove. Used by the Now/Next/Later board and Kanban. *@
<div class="board" style="grid-template-columns:repeat(@Columns.Count, minmax(230px, 1fr))">
    @for (var c = 0; c < Columns.Count; c++)
    {
        var index = c;
        var column = Columns[c];
        var cards = Items.Where(i => EqualityComparer<TKey>.Default.Equals(KeyOf(i), column.Key)).InRankOrder().ToList();
        <div class="column @(overColumn == index && dragging is not null ? "over" : "")"
             @ondragenter="() => overColumn = index"
             @ondragover:preventDefault
             @ondrop="() => DropAsync(column.Key)">
            <div class="column-head">
                @column.Label
                <span class="count">@cards.Count</span>
            </div>
            @foreach (var item in cards)
            {
                var path = Roadmap.PathOf(item);
                <div class="board-card @(dragging?.Id == item.Id ? "dragging" : "")" @key="item.Id"
                     draggable="true"
                     style="border-left-color:@Ui.ColorOf(item)"
                     @ondragstart="() => dragging = item"
                     @ondragend="() => { dragging = null; overColumn = -1; }">
                    @if (path.Length > 0)
                    {
                        <div class="path" title="@path">@path</div>
                    }
                    <div class="ttl" @onclick="() => OnEdit.InvokeAsync(item)">@item.Title</div>
                    <div class="row" style="gap:.3rem">
                        <TypeBadge Type="item.ItemType" />
                        @CardBadges?.Invoke(item)
                        @if (Roadmap.IsBlocked(item.Id))
                        {
                            <span class="badge blocked">blocked</span>
                        }
                        <span class="spacer"></span>
                        <span class="small muted" title="@Roadmap.Strategy.DisplayName score">@Ui.ScoreText(item, Roadmap.Product.ScoringModel)</span>
                    </div>
                    @if (item.Owner is not null || item.EndDate is not null)
                    {
                        <div class="row small muted">
                            @item.Owner
                            <span class="spacer"></span>
                            @if (item.EndDate is { } end)
                            {
                                <span class="@(ProductRoadmap.IsOverdue(item, today) ? "overdue" : "")">due @end.ToString("MMM d")</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    public record Column(TKey Key, string Label);

    [Parameter, EditorRequired] public ProductRoadmap Roadmap { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<Column> Columns { get; set; } = [];
    [Parameter, EditorRequired] public IEnumerable<RoadmapItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public Func<RoadmapItem, TKey> KeyOf { get; set; } = default!;
    [Parameter] public EventCallback<(RoadmapItem Item, TKey To)> OnMove { get; set; }
    [Parameter] public EventCallback<RoadmapItem> OnEdit { get; set; }
    /// <summary>Extra badges shown on each card after the type badge.</summary>
    [Parameter] public RenderFragment<RoadmapItem>? CardBadges { get; set; }

    private readonly DateOnly today = DateOnly.FromDateTime(DateTime.Today);
    private RoadmapItem? dragging;
    private int overColumn = -1;

    private async Task DropAsync(TKey to)
    {
        var item = dragging;
        dragging = null;
        overColumn = -1;
        if (item is null || EqualityComparer<TKey>.Default.Equals(KeyOf(item), to)) return;
        await OnMove.InvokeAsync((item, to));
    }
}
