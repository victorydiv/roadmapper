@inject PortfolioService Svc

<div class="modal-backdrop">
    <div class="modal narrow">
        <EditForm Model="draft" OnValidSubmit="SaveAsync">
            <div class="modal-head">
                <h2>@(draft.IsNew ? "New trading partner" : $"Edit {original}")</h2>
                <span class="spacer"></span>
                <button type="button" class="btn icon" title="Close" @onclick="() => CloseAsync(null)">✕</button>
            </div>

            <div class="modal-body">
                @if (error is not null)
                {
                    <div class="alert">@error</div>
                }
                <label class="field">Name
                    <InputText @bind-Value="draft.Name" autofocus />
                </label>
                <div class="grid-3">
                    <label class="field">Type
                        <InputSelect @bind-Value="draft.Type">
                            @foreach (var t in Enum.GetValues<PartnerType>())
                            {
                                <option value="@t">@PortfolioText.Label(t)</option>
                            }
                        </InputSelect>
                    </label>
                    <label class="field" title="Key partners: a break in their flows is high severity">Importance
                        <InputSelect @bind-Value="draft.Importance">
                            @foreach (var i in Enum.GetValues<PartnerImportance>())
                            {
                                <option value="@i">@PortfolioText.Label(i)</option>
                            }
                        </InputSelect>
                    </label>
                    <label class="field" title="Onboarding: being set up and tested, not live yet">Status
                        <InputSelect @bind-Value="draft.Status">
                            @foreach (var s in Enum.GetValues<PartnerStatus>())
                            {
                                <option value="@s">@PortfolioText.Label(s)</option>
                            }
                        </InputSelect>
                    </label>
                </div>

                <fieldset>
                    <legend>Identifiers</legend>
                    <label class="field" title="Your ID for them, e.g. the customer code in the WMS or ERP">Account / customer code
                        <InputText @bind-Value="draft.AccountCode" />
                    </label>
                    <div class="grid-3">
                        <label class="field" title="ISA05/ISA07 qualifier, e.g. 01 (DUNS), 12 (phone), ZZ (mutually defined)">EDI qualifier
                            <InputText @bind-Value="draft.EdiQualifier" maxlength="2" placeholder="ZZ" />
                        </label>
                        <label class="field" title="ISA06/ISA08 interchange ID">EDI ID (ISA)
                            <InputText @bind-Value="draft.EdiId" maxlength="35" />
                        </label>
                        <label class="field" title="GS02/GS03 application ID, if different from the ISA ID">GS ID
                            <InputText @bind-Value="draft.GsId" maxlength="35" />
                        </label>
                    </div>
                </fieldset>

                <label class="field" title="Who owns the relationship on your side: account manager, customer-service lead">Relationship owner
                    <ContactSelect Contacts="contacts" Vendors="vendors" Partners="partners" @bind-Value="draft.RelationshipOwnerId" />
                </label>
                <label class="field">Notes
                    <InputTextArea @bind-Value="draft.Notes" />
                </label>
            </div>

            <div class="modal-foot">
                @if (!draft.IsNew)
                {
                    @if (confirmingDelete)
                    {
                        <span class="small">Delete @original and their people? Setting them to Inactive keeps the history.</span>
                        <button type="button" class="btn danger" @onclick="DeleteAsync">Confirm delete</button>
                        <button type="button" class="btn" @onclick="() => confirmingDelete = false">Keep</button>
                    }
                    else
                    {
                        <button type="button" class="btn danger" @onclick="() => confirmingDelete = true">Delete</button>
                    }
                }
                <span class="spacer"></span>
                <button type="button" class="btn" @onclick="() => CloseAsync(null)">Cancel</button>
                <button type="submit" class="btn primary" disabled="@saving">@(draft.IsNew ? "Create" : "Save")</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TradingPartnerDraft Draft { get; set; } = default!;
    /// <summary>Called with the saved partner's id, 0 when it was deleted, or null when nothing changed.</summary>
    [Parameter] public EventCallback<int?> OnClose { get; set; }

    private TradingPartnerDraft draft = default!;
    private string original = "";
    private List<Contact> contacts = [];
    private List<Vendor> vendors = [];
    private List<TradingPartner> partners = [];
    private bool saving, confirmingDelete;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        draft = Draft;
        original = Draft.Name;
        contacts = await Svc.GetContactsAsync();
        vendors = await Svc.GetVendorsAsync();
        partners = await Svc.GetPartnersAsync();
    }

    private async Task SaveAsync()
    {
        saving = true;
        error = null;
        try
        {
            var id = await Svc.SavePartnerAsync(draft);
            await CloseAsync(id);
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
        finally { saving = false; }
    }

    private async Task DeleteAsync()
    {
        error = null;
        try
        {
            await Svc.DeletePartnerAsync(draft.Id);
            await CloseAsync(0);
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
            confirmingDelete = false;
        }
    }

    private Task CloseAsync(int? result) => OnClose.InvokeAsync(result);
}
