@* Documents for one record's page: those attached to it (Target), or those belonging to a product (ProductId only). Upload and Link start from there. *@
@inject PortfolioService Svc

<div class="card stack @CssClass" style="@(CssClass is null ? "margin-top:1rem" : null)">
    <div class="row">
        <h2 style="margin:0">Documents</h2>
        <span class="muted small">Kept in SharePoint.</span>
        <span class="spacer"></span>
        @if (Target is null && ProductId is { } pid)
        {
            <a class="small" href="/portfolio/documents?product=@pid">All →</a>
        }
        <button class="btn" @onclick="() => New(upload: true)">+ Upload</button>
        <button class="btn" @onclick="() => New(upload: false)" title="Add a link to a document that's already in SharePoint">+ Link</button>
    </div>
    @if (documents is null)
    {
        <div class="muted small">Loading…</div>
    }
    else if (documents.Count == 0)
    {
        <div class="muted small">None for @Name yet.</div>
    }
    else
    {
        <DocumentTable Documents="documents" ShowTarget="Target is null || Targets is { Count: > 1 }" ShowProduct="Target is not null" OnEdit="Edit" />
    }
</div>

@if (editing is not null)
{
    <DocumentEditor Draft="editing" Upload="upload" Document="editingDoc" Targets="Choices" OnClose="OnClosed" />
}

@code {
    /// <summary>The record whose documents these are. Null: a product's documents (<see cref="ProductId"/>).</summary>
    [Parameter] public DocumentTarget? Target { get; set; }
    /// <summary>The product new documents belong to by default; without a <see cref="Target"/>, the product whose documents are listed.</summary>
    [Parameter] public int? ProductId { get; set; }
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    /// <summary>Extra classes for the card, e.g. "wide" in a dashboard grid (which also drops its top margin).</summary>
    [Parameter] public string? CssClass { get; set; }
    /// <summary>
    /// What a document added here may be attached to, when there's a choice (a vendor and its contracts). The list
    /// shows documents attached to any of them; <see cref="Target"/> comes first and is the default.
    /// </summary>
    [Parameter] public IReadOnlyList<DocumentTargetOption>? Targets { get; set; }

    private List<PortfolioDocument>? documents;
    private DocumentDraft? editing;
    private PortfolioDocument? editingDoc;
    private bool upload;

    /// <summary>On a product's page: anything, with a picker. On a record's page: that record (or the given choices).</summary>
    private IReadOnlyList<DocumentTargetOption>? Choices => Target is { } t ? Targets ?? [new DocumentTargetOption(t, Name, null, ProductId)] : null;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync() =>
        documents = Target is { } t ? await Svc.GetDocumentsAsync(t) : await Svc.GetDocumentsAsync(productId: ProductId ?? -1);

    private void New(bool upload)
    {
        this.upload = upload;
        editingDoc = null;
        editing = DocumentDraft.New(Target, ProductId);
    }

    private void Edit(PortfolioDocument d)
    {
        editingDoc = d;
        editing = DocumentDraft.From(d);
    }

    private async Task OnClosed(int? id)
    {
        editing = null;
        if (id is not null) await LoadAsync();
    }
}
