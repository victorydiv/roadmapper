@inject PortfolioService Svc

@* A person picker: internal staff first, then each vendor's and trading partner's people. "+ New" adds someone without leaving the form. *@
<div class="contact-select">
    @if (!adding)
    {
        <div class="row nowrap">
            <select value="@(Value?.ToString() ?? "")" @onchange="OnPicked" style="flex:1">
                <option value="">— none —</option>
                @foreach (var group in Groups)
                {
                    <optgroup label="@group.Key">
                        @foreach (var c in group)
                        {
                            <option value="@c.Id">@c.Name@(c.Title is { } t ? $" · {t}" : "")@(c.IsActive ? "" : " (inactive)")</option>
                        }
                    </optgroup>
                }
            </select>
            <button type="button" class="btn sm" title="Add a new person" @onclick="StartAdding">+ New</button>
        </div>
    }
    else
    {
        <div class="stack new-contact">
            @if (error is not null)
            {
                <div class="alert small">@error</div>
            }
            <div class="grid-2">
                <input placeholder="Name" @bind="draft.Name" @bind:event="oninput" />
                <input placeholder="Title (optional)" @bind="draft.Title" />
                <input placeholder="Email (optional)" @bind="draft.Email" />
                <select @bind="draft.CompanyKey">
                    <option value="">Internal (our company)</option>
                    @if (Vendors.Count > 0)
                    {
                        <optgroup label="Vendors">
                            @foreach (var v in Vendors)
                            {
                                <option value="v@(v.Id)">@v.Name</option>
                            }
                        </optgroup>
                    }
                    @if (Partners.Count > 0)
                    {
                        <optgroup label="Trading partners">
                            @foreach (var tp in Partners)
                            {
                                <option value="p@(tp.Id)">@tp.Name</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
            <div class="row">
                <button type="button" class="btn primary sm" disabled="@string.IsNullOrWhiteSpace(draft.Name)" @onclick="CreateAsync">Add person</button>
                <button type="button" class="btn sm" @onclick="() => adding = false">Cancel</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<Contact> Contacts { get; set; } = [];
    /// <summary>Vendors offered for a new person's company.</summary>
    [Parameter] public IReadOnlyList<Vendor> Vendors { get; set; } = [];
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }
    /// <summary>Trading partners offered for a new person's company.</summary>
    [Parameter] public IReadOnlyList<TradingPartner> Partners { get; set; } = [];
    /// <summary>This vendor's people are listed first, and a new person defaults to it.</summary>
    [Parameter] public int? PreferVendorId { get; set; }
    /// <summary>This partner's people are listed first, and a new person defaults to it.</summary>
    [Parameter] public int? PreferPartnerId { get; set; }

    private bool adding;
    private ContactDraft draft = new();
    private string? error;

    private IEnumerable<IGrouping<string, Contact>> Groups => Contacts
        .Where(c => c.IsActive || c.Id == Value)
        .OrderBy(c => Preferred(c) ? 0 : c.IsInternal ? 1 : 2)
        .ThenBy(c => Company(c)).ThenBy(c => c.Name)
        .GroupBy(c => Company(c) ?? "Internal");

    private bool Preferred(Contact c) =>
        (PreferVendorId is not null && c.VendorId == PreferVendorId) || (PreferPartnerId is not null && c.TradingPartnerId == PreferPartnerId);

    private string? Company(Contact c) => c.CompanyName
        ?? (c.VendorId is { } v ? Vendors.FirstOrDefault(x => x.Id == v)?.Name : null)
        ?? (c.TradingPartnerId is { } p ? Partners.FirstOrDefault(x => x.Id == p)?.Name : null);

    private Task OnPicked(ChangeEventArgs e) =>
        ValueChanged.InvokeAsync(int.TryParse(e.Value as string, out var id) ? id : null);

    private void StartAdding()
    {
        draft = new ContactDraft { VendorId = PreferVendorId, TradingPartnerId = PreferVendorId is null ? PreferPartnerId : null };
        error = null;
        adding = true;
    }

    private async Task CreateAsync()
    {
        error = null;
        try
        {
            var id = await Svc.SaveContactAsync(draft);
            var contact = new Contact { Id = id };
            draft.ApplyTo(contact);
            contact.Vendor = Vendors.FirstOrDefault(v => v.Id == draft.VendorId);
            contact.TradingPartner = Partners.FirstOrDefault(p => p.Id == draft.TradingPartnerId);
            Contacts.Add(contact);
            adding = false;
            await ValueChanged.InvokeAsync(id);
        }
        catch (InvalidOperationException ex) { error = ex.Message; }
    }
}
