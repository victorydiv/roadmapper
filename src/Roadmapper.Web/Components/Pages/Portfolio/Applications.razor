@page "/portfolio/applications"
@inject PortfolioService Svc
@inject NavigationManager Nav

<PortfolioHeader Title="Applications" Subtitle="The enterprise applications you own, who supplies them, and what they cost.">
    <button class="btn primary" @onclick="() => editing = new ApplicationDraft()">+ New application</button>
</PortfolioHeader>

@if (error is not null)
{
    <div class="alert" style="margin-bottom:1rem">@error</div>
}

@if (apps is null)
{
    <p class="muted">Loading…</p>
}
else if (apps.Count == 0)
{
    <div class="card empty stack">
        <div>No applications yet. Add your WMS, TMS, ERP, EDI platform and the rest, or start from a sample portfolio.</div>
        <div class="row" style="justify-content:center">
            <button class="btn primary" @onclick="() => editing = new ApplicationDraft()">+ New application</button>
            @if (canSeed)
            {
                <button class="btn" @onclick="SeedAsync">Add sample portfolio</button>
            }
        </div>
    </div>
}
else
{
    <div class="tiles" style="margin-bottom:1rem">
        <div class="card tile">
            <span class="tile-label">Applications</span>
            <span class="tile-value">@apps.Count(PortfolioRules.CountsInPortfolio)</span>
            <span class="muted small">@apps.Count(a => a.Criticality == Criticality.Tier1 && PortfolioRules.CountsInPortfolio(a)) Tier 1</span>
        </div>
        <div class="card tile">
            <span class="tile-label">Annual run cost</span>
            <span class="tile-value">@PortfolioUi.MoneyShort(apps.Where(PortfolioRules.CountsInPortfolio).Sum(a => a.AnnualCost ?? 0))</span>
            <span class="muted small">active, planned &amp; retiring</span>
        </div>
        <div class="card tile">
            <span class="tile-label">Notice due ≤ @warningDays days</span>
            <span class="tile-value @(NoticeSoon > 0 ? "due-soon" : "")">@NoticeSoon</span>
            <span class="muted small"><a href="/portfolio/vendors">See renewals</a></span>
        </div>
        <div class="card tile">
            <span class="tile-label">Retiring</span>
            <span class="tile-value">@apps.Count(a => a.Status == LifecycleStatus.Retiring)</span>
            <span class="muted small">@apps.Count(a => a.TimeQuadrant == TimeQuadrant.Eliminate) rated Eliminate</span>
        </div>
    </div>

    <div class="toolbar">
        <input placeholder="Search name, vendor or owner" @bind="search" @bind:event="oninput" style="max-width:260px" />
        <select @bind="category">
            <option value="">All categories</option>
            @foreach (var c in Enum.GetValues<AppCategory>())
            {
                <option value="@c">@PortfolioText.Label(c)</option>
            }
        </select>
        <select @bind="tier">
            <option value="">All tiers</option>
            @foreach (var t in Enum.GetValues<Criticality>())
            {
                <option value="@t">@PortfolioText.Label(t)</option>
            }
        </select>
        <select @bind="status">
            <option value="">All but retired</option>
            @foreach (var s in Enum.GetValues<LifecycleStatus>())
            {
                <option value="@s">@PortfolioText.Label(s)</option>
            }
        </select>
        <span class="spacer"></span>
        <div class="segmented">
            <button class="@(matrix ? "" : "on")" @onclick="() => matrix = false">Table</button>
            <button class="@(matrix ? "on" : "")" @onclick="() => matrix = true" title="Gartner TIME: business fit × technical fit">TIME matrix</button>
        </div>
    </div>

    @if (!matrix)
    {
        <div class="card table-wrap">
            <table class="tree">
                <thead>
                    <tr>
                        <th>Application</th>
                        <th>Category</th>
                        <th>Tier</th>
                        <th>Status</th>
                        <th>Vendor</th>
                        <th>Business owner</th>
                        <th class="num">Annual cost</th>
                        <th>Notice deadline</th>
                        <th>TIME</th>
                        <th title="Health score 0–100: integration risk, overdue reviews, notice deadlines, retiring with live flows, fit">Health</th>
                        <th class="num" title="Linked roadmap items">Roadmap</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Filtered)
                    {
                        <tr>
                            <td class="title-cell"><a class="title-link" href="/portfolio/applications/@a.Id">@a.Name</a></td>
                            <td>@PortfolioText.Label(a.Category)</td>
                            <td><TierBadge Tier="a.Criticality" /></td>
                            <td><LifecycleBadge Status="a.Status" /></td>
                            <td>@if (a.Vendor is { } v) { <a href="/portfolio/vendors/@v.Id">@v.Name</a> } else { <span class="muted">–</span> }</td>
                            <td>@(a.BusinessOwner?.Name ?? "–")</td>
                            <td class="num">@PortfolioUi.Money(a.AnnualCost)</td>
                            <td class="@PortfolioUi.NoticeClass(a.Contract, today, warningDays)" title="@(a.RenewalDate is { } r ? $"Renews {PortfolioUi.Date(r)}" : "")">
                                @(a.NoticeDeadline is { } d ? PortfolioUi.Date(d) : "–")
                            </td>
                            <td><TimeBadge Quadrant="a.TimeQuadrant" /></td>
                            <td><HealthBadge Health="health.GetValueOrDefault(a.Id)" ShowScore="true" /></td>
                            <td class="num">
                                @if (a.ProductId is { } pid)
                                {
                                    <a href="/products/@pid" title="Open this application's roadmap">roadmap</a>
                                }
                                @(a.Initiatives.Count > 0 ? $" {a.Initiatives.Count} linked" : "")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Filtered.Any())
            {
                <div class="empty muted">No applications match these filters.</div>
            }
        </div>
    }
    else
    {
        var unscored = Filtered.Where(a => a.TimeQuadrant is null).ToList();
        <div class="time-matrix">
            <div class="axis-y">Business fit →</div>
            @foreach (var q in new[] { TimeQuadrant.Migrate, TimeQuadrant.Invest, TimeQuadrant.Eliminate, TimeQuadrant.Tolerate })
            {
                <div class="card quadrant q-@q">
                    <div class="row"><TimeBadge Quadrant="q" /><span class="muted small">@PortfolioText.Describe(q)</span></div>
                    <ul class="item-list">
                        @foreach (var a in Filtered.Where(a => a.TimeQuadrant == q))
                        {
                            <li>
                                <a href="/portfolio/applications/@a.Id">@a.Name</a>
                                <span class="spacer"></span>
                                <TierBadge Tier="a.Criticality" />
                                <span class="muted small" title="Business fit / technical fit">@a.BusinessFit / @a.TechnicalFit</span>
                            </li>
                        }
                    </ul>
                </div>
            }
            <div class="axis-x">Technical fit →</div>
        </div>
        @if (unscored.Count > 0)
        {
            <div class="muted small" style="margin-top:.5rem">
                Not placed (no fit scores yet): @string.Join(", ", unscored.Select(a => a.Name))
            </div>
        }
    }

    <h3 class="sub" style="margin-top:1.5rem">Recent portfolio changes</h3>
    <div class="card">
        <PortfolioActivityList Entries="activity" ShowName="true" />
    </div>
}

@if (editing is not null)
{
    <ApplicationEditor Draft="editing" OnClose="OnEditorClosed" />
}

@code {
    private List<Application>? apps;
    private Dictionary<int, AppHealth> health = [];
    private List<PortfolioAuditEntry> activity = [];
    private ApplicationDraft? editing;
    private bool canSeed, matrix;
    private string? error;
    private string search = "";
    private AppCategory? category;
    private Criticality? tier;
    private LifecycleStatus? status;
    private int warningDays = 120;
    private DateOnly today;

    private IEnumerable<Application> Filtered => apps!
        .Where(a => status is { } s ? a.Status == s : a.Status != LifecycleStatus.Retired)
        .Where(a => category is null || a.Category == category)
        .Where(a => tier is null || a.Criticality == tier)
        .Where(a => string.IsNullOrWhiteSpace(search)
            || a.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
            || (a.Vendor?.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (a.BusinessOwner?.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (a.TechnicalOwner?.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false));

    /// <summary>Distinct contracts whose notice deadline is coming up (or was missed but hasn't renewed yet).</summary>
    private int NoticeSoon => apps!.Where(a => a.Contract is not null).Select(a => a.Contract!).DistinctBy(c => c.Id)
        .Count(c => PortfolioRules.NoticeDue(c, today, warningDays) || PortfolioRules.NoticeMissed(c, today));

    protected override async Task OnInitializedAsync()
    {
        today = Svc.Today;
        warningDays = (await Svc.GetSettingsAsync()).RenewalWarningDays;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        apps = await Svc.GetApplicationsAsync();
        health = await Svc.GetHealthAsync();
        activity = await Svc.GetRecentActivityAsync(15);
        canSeed = apps.Count == 0 && await Svc.IsEmptyAsync();
    }

    private async Task OnEditorClosed(int? id)
    {
        editing = null;
        if (id is > 0) Nav.NavigateTo($"/portfolio/applications/{id}");
        else if (id is not null) await ReloadAsync();
    }

    private async Task SeedAsync()
    {
        error = null;
        try { await Svc.SeedSampleAsync(); }
        catch (InvalidOperationException ex) { error = ex.Message; }
        await ReloadAsync();
    }
}
