@page "/capabilities"
@inject PortfolioService Svc

<PageTitle>Capabilities</PageTitle>

<div class="product-header">
    <div>
        <h1>Capabilities</h1>
        <div class="muted small">
            Compare applications feature by feature, one application category at a time: define the features that matter for a
            category, rate each application on them, and see the comparison matrix and heat map.
        </div>
    </div>
</div>

@if (overview is null)
{
    <p class="muted">Loading…</p>
}
else
{
    <div class="cap-cards">
        @foreach (var o in overview.OrderByDescending(o => o.Features > 0).ThenBy(o => o.Category))
        {
            <a class="card cap-card @(o.Features == 0 ? "empty-cat" : "")" href="@PortfolioUi.CapabilitiesHref(o.Category, o.Features == 0 ? "features" : null)">
                <h2 style="margin:0">@PortfolioText.Label(o.Category)</h2>
                @if (o.Features == 0)
                {
                    <span class="muted small">@o.Applications application@(o.Applications == 1 ? "" : "s") · no features yet</span>
                    <span class="small">Set up features →</span>
                }
                else
                {
                    <span class="small">@o.Features feature@(o.Features == 1 ? "" : "s") × @o.Applications application@(o.Applications == 1 ? "" : "s")</span>
                    <span class="progress @(o.AssessedPct >= 100 ? "done" : "")" title="@o.AssessedPct% of the cells rated"><span style="width:@o.AssessedPct%"></span></span>
                    <span class="muted small">@o.AssessedPct% rated@(o.Gaps > 0 ? $" · {o.Gaps} gap{(o.Gaps == 1 ? "" : "s")}" : "")</span>
                }
            </a>
        }
    </div>
}

@code {
    private List<CapabilityOverview>? overview;

    protected override async Task OnInitializedAsync() => overview = await Svc.GetCapabilityOverviewAsync();
}
