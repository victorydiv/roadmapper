@page "/capabilities/{CategoryName}"
@inject PortfolioService Svc
@inject NavigationManager Nav

<PageTitle>@Title · Capabilities</PageTitle>

@if (category is not { } cat)
{
    <div class="card empty">There's no application category called “@CategoryName”. <a href="/capabilities">All categories</a></div>
}
else
{
    <div class="product-header">
        <div>
            <div class="small"><a href="/capabilities">Capabilities</a> /</div>
            <h1>@Title</h1>
            <div class="muted small">
                @(matrix is null ? "" : $"{matrix.Features.Count} features × {(matrix.Narrowed ? $"{matrix.Apps.Count} of {matrix.AllApps}" : matrix.Apps.Count)} applications")
                @if (matrix is { Features.Count: > 0, Apps.Count: > 0 })
                {
                    <span> · @matrix.Gaps gap@(matrix.Gaps == 1 ? "" : "s") · @matrix.Overlaps overlap@(matrix.Overlaps == 1 ? "" : "s")</span>
                }
            </div>
        </div>
        <span class="spacer"></span>
        <a class="btn" href="@ExportHref" download>Export to Excel</a>
    </div>

    <nav class="tabs">
        <a class="@(View == "matrix" ? "active" : "")" href="@PortfolioUi.CapabilitiesHref(cat, null, Only)">Comparison matrix</a>
        <a class="@(View == "heatmap" ? "active" : "")" href="@PortfolioUi.CapabilitiesHref(cat, "heatmap", Only)">Heat map</a>
        <a class="@(View == "cost" ? "active" : "")" href="@PortfolioUi.CapabilitiesHref(cat, "cost", Only)">Cost</a>
        <a class="@(View == "features" ? "active" : "")" href="@PortfolioUi.CapabilitiesHref(cat, "features", Only)">Features &amp; applications</a>
    </nav>

    @if (matrix is { Narrowed: true } && View != "features")
    {
        <div class="card row narrowed" style="margin-bottom:.75rem;flex-wrap:wrap">
            <span>Comparing <b>@matrix.Apps.Count of @matrix.AllApps</b> applications: @string.Join(", ", matrix.Apps.Select(a => a.Name)).</span>
            <span class="muted small">Gaps, overlaps, strongest and lowest cost are among these only.</span>
            <span class="spacer"></span>
            <a class="btn sm" href="@PortfolioUi.CapabilitiesHref(cat, ViewKey)">Show all applications</a>
        </div>
    }

    @if (error is not null)
    {
        <div class="alert" style="margin-bottom:.75rem">@error</div>
    }

    @if (matrix is null)
    {
        <p class="muted">Loading…</p>
    }
    else if (View == "features")
    {
        <div class="settings">
            <div class="card stack">
                <h2>Features</h2>
                <div class="muted small">What @Title applications are compared on, in the order they're shown. Renaming keeps the ratings; deleting a feature deletes its ratings.</div>
                @if (matrix.Features.Count == 0)
                {
                    <div class="muted small">No features yet. Add the first below, e.g. “Dock scheduling”.</div>
                }
                <ul class="dep-list">
                    @foreach (var (f, n) in matrix.Features.Select((f, n) => (f, n)))
                    {
                        <li>
                            @if (editingFeature?.Id == f.Id)
                            {
                                <div class="stack" style="flex:1">
                                    <input @bind="editingFeature.Name" />
                                    <input @bind="editingFeature.Description" placeholder="Description (optional): what counts as having it" />
                                    <div class="row">
                                        <button class="btn sm primary" @onclick="SaveFeatureAsync">Save</button>
                                        <button class="btn sm" @onclick="() => editingFeature = null">Cancel</button>
                                    </div>
                                </div>
                            }
                            else if (deletingFeatureId == f.Id)
                            {
                                <span class="small">Delete “@f.Name” and its @matrix.Apps.Count(a => matrix.Cell(f.Id, a.Id) is not null) rating(s)?</span>
                                <span class="spacer"></span>
                                <button class="btn sm danger" @onclick="() => RunAsync(() => Svc.DeleteFeatureAsync(f.Id))">Delete</button>
                                <button class="btn sm" @onclick="() => deletingFeatureId = null">Keep</button>
                            }
                            else
                            {
                                <span><b>@f.Name</b>@if (f.Description is not null) { <span class="muted small"> · @f.Description</span> }</span>
                                <span class="spacer"></span>
                                <button class="btn icon sm" title="Move up" disabled="@(n == 0)" @onclick="() => RunAsync(() => Svc.MoveFeatureAsync(f.Id, -1))">↑</button>
                                <button class="btn icon sm" title="Move down" disabled="@(n == matrix.Features.Count - 1)" @onclick="() => RunAsync(() => Svc.MoveFeatureAsync(f.Id, 1))">↓</button>
                                <button class="btn sm" @onclick="() => editingFeature = FeatureDraft.From(f)">Edit</button>
                                <button class="btn sm danger" @onclick="() => deletingFeatureId = f.Id">Delete</button>
                            }
                        </li>
                    }
                </ul>
                <div class="row">
                    <input placeholder="New feature, e.g. Gate security" @bind="newFeature" @onkeydown="OnNewFeatureKey" style="flex:1" />
                    <button class="btn primary" disabled="@string.IsNullOrWhiteSpace(newFeature)" @onclick="AddFeatureAsync">Add</button>
                </div>
            </div>

            <div class="card stack">
                <h2>Compared applications</h2>
                <div class="muted small">
                    Every @Title application is included. Add applications from other categories that cover some of the same ground
                    (e.g. a WMS with yard features). Candidates you're only considering: add them as applications with status
                    <b>Evaluating</b>; they're left out of portfolio totals.
                </div>
                <ul class="dep-list">
                    @foreach (var a in matrix.Apps)
                    {
                        <li>
                            <a href="/portfolio/applications/@a.Id">@a.Name</a>
                            <LifecycleBadge Status="a.Application.Status" />
                            @if (a.Added) { <span class="badge added">@PortfolioText.Label(a.Application.Category)</span> }
                            <span class="spacer"></span>
                            @if (a.Added)
                            {
                                <button class="btn sm" title="Take it out of this comparison (its ratings are kept)" @onclick="() => RunAsync(() => Svc.RemoveComparisonMemberAsync(cat, a.Id))">Remove</button>
                            }
                            else
                            {
                                <span class="muted small">@Title</span>
                            }
                        </li>
                    }
                </ul>
                @if (matrix.Apps.Count == 0)
                {
                    <div class="muted small">No @Title applications yet. <a href="/portfolio/applications">Add applications</a> with category @Title, or add some from other categories here.</div>
                }
                <div class="row">
                    <select @bind="addAppId" style="flex:1">
                        <option value="0">— add an application from another category —</option>
                        @foreach (var a in others)
                        {
                            <option value="@a.Id">@a.Name (@PortfolioText.Label(a.Category)@(a.Status == LifecycleStatus.Active ? "" : $", {PortfolioText.Label(a.Status)}"))</option>
                        }
                    </select>
                    <button class="btn" disabled="@(addAppId == 0)" @onclick="AddMemberAsync">Add</button>
                </div>
                <label class="check"><input type="checkbox" checked="@includeRetired" @onchange="ToggleRetiredAsync" /><span>Show retired applications</span></label>
            </div>
        </div>
    }
    else if (View == "cost")
    {
        <div class="card stack" style="margin-bottom:1rem">
            <div class="row" style="flex-wrap:wrap">
                <b>Costed for</b>
                <select value="@profileId" @onchange="OnProfileChanged">
                    @if (profiles.Count == 0)
                    {
                        <option value="-1">One site (no profiles yet)</option>
                    }
                    @foreach (var p in profiles)
                    {
                        <option value="@p.Id">@p.Name@(p.IsDefault ? " (default)" : "")</option>
                    }
                    <option value="0">Try your own site…</option>
                </select>
                <span class="muted small">@PortfolioUi.Sizes(matrix.Site)</span>
                <span class="spacer"></span>
                @if (profiles.FirstOrDefault(p => p.Id == matrix.Site.Id && matrix.Site.Id > 0) is { } current)
                {
                    <button class="btn sm" @onclick="() => editingProfile = SiteProfileDraft.From(current)">Edit profile</button>
                }
                <button class="btn sm" @onclick="NewProfile">Add site profile</button>
            </div>
            @if (profileId == 0)
            {
                <div class="muted small">Type your site's sizes to see what each solution would cost it. Nothing is saved unless you save it as a profile.</div>
                <SiteSizeFields Draft="trial" OnChange="LoadAsync" />
                <div><button class="btn sm" @onclick="SaveTrialAsProfile">Save as a site profile</button></div>
            }
            else if (profiles.Count == 0)
            {
                <div class="muted small">
                    Solutions are adopted one site at a time, so costs are worked out for a typical site. Add a site profile (e.g. “Small DC: 15 users, 10 dock doors”)
                    so per-user, per-door and per-transaction prices can be costed; until then only flat and per-site prices are.
                </div>
            }
        </div>

        @if (matrix.Apps.Count == 0)
        {
            <div class="card empty">No applications to compare yet. <a href="@PortfolioUi.CapabilitiesHref(cat, "features")">Set up applications →</a></div>
        }
        else
        {
            <div class="card" style="padding:0;margin-bottom:1rem">
                <table class="tree cost-table">
                    <thead>
                        <tr>
                            <th>Application</th>
                            <th class="num">Monthly</th>
                            <th class="num">One-time</th>
                            <th class="num">First year</th>
                            <th class="num" title="Monthly cost per user">Per user / mo</th>
                            <th class="num" title="Monthly cost per dock door">Per door / mo</th>
                            <th class="num" title="Features it has (Yes) of all features">Features</th>
                            <th>Prices from</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in CostOrder())
                        {
                            var k = matrix.Cost(a.Id);
                            var cv = matrix.ByApp[a.Id];
                            <tr class="@(matrix.Cheapest.Contains(a.Id) ? "cheapest" : "")" title="@PortfolioUi.CostTip(a.Name, k, matrix.Site)">
                                <td>
                                    <a href="/portfolio/applications/@a.Id">@a.Name</a>
                                    @if (a.Application.Status != LifecycleStatus.Active) { <LifecycleBadge Status="a.Application.Status" /> }
                                    @if (matrix.Cheapest.Contains(a.Id)) { <span class="badge cheapest">Lowest monthly</span> }
                                </td>
                                @if (!k.IsPriced)
                                {
                                    <td colspan="5" class="muted small">Not priced</td>
                                }
                                else
                                {
                                    <td class="num"><b>@PortfolioUi.MonthlyText(k)</b></td>
                                    <td class="num">@PortfolioUi.Money(k.OneTime)</td>
                                    <td class="num">@((k.IsComplete ? "" : "≥ ") + PortfolioUi.Money(Math.Round(k.FirstYear)))</td>
                                    <td class="num">@PortfolioUi.Money(k.MonthlyPer(matrix.Site.Users))</td>
                                    <td class="num">@PortfolioUi.Money(k.MonthlyPer(matrix.Site.DockDoors))</td>
                                }
                                <td class="num">@(matrix.Features.Count == 0 ? "–" : $"{cv.Yes}/{cv.Total}")</td>
                                <td class="small">
                                    @string.Join(", ", k.Sources.Select(PortfolioText.Label))
                                    @if (k.IsPriced && !k.IsComplete) { <span class="badge gap" title="The site profile doesn't size: @string.Join(", ", k.Missing)">Incomplete</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="muted small" style="margin-bottom:1rem">
                Monthly = monthly prices plus annual ones ÷ 12; first year = 12 months plus one-time costs. “≥” and Incomplete: some prices are per something the
                site profile doesn't size, so they're left out. Hover a row for details.
            </div>

            <div class="cost-cards">
                @foreach (var a in matrix.Apps)
                {
                    var k = matrix.Cost(a.Id);
                    <div class="card stack">
                        <div class="row">
                            <h3 style="margin:0"><a href="/portfolio/applications/@a.Id">@a.Name</a></h3>
                            @if (a.Added) { <span class="badge added">@PortfolioText.Label(a.Application.Category)</span> }
                            <span class="spacer"></span>
                            <button class="btn sm" @onclick="() => pricing = (PricingLineDraft.New(cat, a.Id), a.Name)">Add price</button>
                        </div>
                        @if (!k.IsPriced)
                        {
                            <div class="muted small">No pricing yet. Add each part of the quote: subscription, implementation, hardware, support.</div>
                        }
                        else
                        {
                            <table class="tree">
                                <thead><tr><th>Price</th><th>As quoted</th><th class="num">Qty</th><th class="num">Charge</th><th>Source</th></tr></thead>
                                <tbody>
                                    @foreach (var line in k.Lines)
                                    {
                                        var l = line.Line;
                                        <tr style="cursor:pointer" title="@(l.Note ?? "Click to edit")" @onclick="() => pricing = (PricingLineDraft.From(l), a.Name)">
                                            <td>@l.Label@if (l.Note is not null) { <span class="note-dot muted"> ●</span> }</td>
                                            <td class="small">@PortfolioUi.Price(l)</td>
                                            <td class="num">@(line.Quantity is { } q ? q.ToString("0.##") : "?")</td>
                                            <td class="num">@(line.Charge is { } ch ? PortfolioUi.Money(Math.Round(ch, 2)) : "–")@(l.Frequency == PriceFrequency.OneTime ? "" : l.Frequency == PriceFrequency.Annual ? " /yr" : " /mo")</td>
                                            <td class="small">@PortfolioText.Label(l.Source)@(l.AsOf is { } d ? $", {PortfolioUi.Date(d)}" : "")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="small"><b>@PortfolioUi.MonthlyText(k)</b> a month · @PortfolioUi.Money(k.OneTime) one-time@(k.IsComplete ? "" : $" · needs {string.Join(", ", k.Missing)}")</div>
                        }
                    </div>
                }
            </div>
        }
    }
    else if (matrix.Features.Count == 0 || matrix.Apps.Count == 0)
    {
        <div class="card empty">
            @(matrix.Features.Count == 0 ? $"No features defined for {Title} yet." : $"No applications to compare yet.")
            <a href="@PortfolioUi.CapabilitiesHref(cat, "features")">Set up features and applications →</a>
        </div>
    }
    else if (View == "heatmap")
    {
        <div class="toolbar">
            <label class="check"><input type="checkbox" checked="@transpose" @onchange="() => transpose = !transpose" /><span>Features down the side</span></label>
            <label class="check"><input type="checkbox" checked="@includeRetired" @onchange="ToggleRetiredAsync" /><span>Include retired</span></label>
            <span class="spacer"></span>
            <a class="btn" href="@($"/export/capabilities/{cat}/heatmap.svg?transpose={transpose}&retired={includeRetired}&download=true{AppsQuery}")" download>Download SVG</a>
            <button class="btn" onclick="window.print()">Print</button>
        </div>
        <div class="card heatmap-wrap">
            @((MarkupString)Roadmapper.Web.Exports.CapabilityHeatmapSvg.Render(matrix, $"{Title}: feature heat map", transpose))
        </div>
        <div class="muted small" style="margin-top:.5rem">
            Strength of each application at each feature. Hover a cell for its rating and note; rate cells on the
            <a href="@PortfolioUi.CapabilitiesHref(cat)">comparison matrix</a>. The SVG can be inserted straight into PowerPoint.
        </div>
    }
    else
    {
        <div class="toolbar">
            <label class="check"><input type="checkbox" @bind="gapsOnly" /><span>Only gaps</span></label>
            @if (matrix.AnyPriced && profiles.Count > 0)
            {
                <label class="check" title="The site the cost rows are worked out for">Cost for
                    <select value="@profileId" @onchange="OnProfileChanged">
                        @foreach (var p in profiles)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                        @if (profileId == 0) { <option value="0">Your site (trial)</option> }
                    </select>
                </label>
            }
            <label class="check"><input type="checkbox" checked="@includeRetired" @onchange="ToggleRetiredAsync" /><span>Include retired</span></label>
            <button class="btn sm primary" disabled="@(Picked.Count < 2)" title="Tick two or more applications' boxes, then compare just those" @onclick="Compare">Compare@(Picked.Count > 0 ? $" {Picked.Count}" : "")</button>
            @if (Picked.Count > 0)
            {
                <button class="btn sm" @onclick="() => picked.Clear()">Clear selection</button>
            }
            <span class="spacer"></span>
            <span class="small"><span class="av-Yes">✓</span> Yes · <span class="av-Partial">◐</span> Partial · <span class="av-No">✗</span> No · blank: not rated. Shading shows strength. Click a cell to rate it.</span>
        </div>
        <div class="card matrix-wrap" style="padding:0">
            <table class="matrix">
                <thead>
                    <tr>
                        <th class="feature">Feature</th>
                        @foreach (var a in matrix.Apps)
                        {
                            <th class="app @(picked.Contains(a.Id) ? "picked" : "")">
                                <label class="pick" title="Select to compare"><input type="checkbox" checked="@picked.Contains(a.Id)" @onchange="() => TogglePick(a.Id)" /></label>
                                <a href="/portfolio/applications/@a.Id">@a.Name</a>
                                @if (a.Application.Status != LifecycleStatus.Active) { <div><LifecycleBadge Status="a.Application.Status" /></div> }
                                @if (a.Added) { <div><span class="badge added">@PortfolioText.Label(a.Application.Category)</span></div> }
                            </th>
                        }
                        <th title="Applications that have it (Yes)">Have it</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in matrix.Features.Where(f => !gapsOnly || matrix.ByFeature[f.Id].IsGap))
                    {
                        var cover = matrix.ByFeature[f.Id];
                        <tr>
                            <th class="feature" title="@f.Description">@f.Name</th>
                            @foreach (var a in matrix.Apps)
                            {
                                var c = matrix.Cell(f.Id, a.Id);
                                <td class="cell @(c?.Strength is { } st ? $"st-{st}" : "")" title="@CellTip(a, f, c)" @onclick="() => Rate(f, a)">
                                    <span class="@(c?.Availability is { } av ? $"av-{av}" : "")">@PortfolioUi.Symbol(c?.Availability)</span>@if (c?.Note is not null) { <span class="note-dot">●</span> }
                                </td>
                            }
                            <td class="num">@cover.Yes@if (cover.Partial > 0) { <span class="muted small"> +@cover.Partial ◐</span> }</td>
                            <td class="nowrap">
                                @if (cover.IsGap) { <span class="badge gap" title="No application has it fully">Gap</span> }
                                @if (cover.IsOverlap) { <span class="badge overlap" title="Two or more applications have it">Overlap</span> }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td style="text-align:left"><b>Coverage</b></td>
                        @foreach (var a in matrix.Apps)
                        {
                            var cv = matrix.ByApp[a.Id];
                            <td title="@cv.Yes yes, @cv.Partial partial, @cv.No no, @cv.Unassessed not rated">
                                <b>@cv.Yes</b>/@cv.Total@if (cv.Partial > 0) { <span> +@cv.Partial◐</span> }
                                <div class="muted">@cv.AssessedPct% rated</div>
                            </td>
                        }
                        <td></td>
                        <td></td>
                    </tr>
                    @if (matrix.AnyPriced)
                    {
                        <tr class="cost-row">
                            <td style="text-align:left" title="Costed for @matrix.Site.Name: @PortfolioUi.Sizes(matrix.Site)"><b>Monthly</b> <span class="muted">· @matrix.Site.Name</span></td>
                            @foreach (var a in matrix.Apps)
                            {
                                var k = matrix.Cost(a.Id);
                                <td class="@(matrix.Cheapest.Contains(a.Id) ? "cheapest" : "")" title="@PortfolioUi.CostTip(a.Name, k, matrix.Site)"><b>@PortfolioUi.MonthlyText(k)</b></td>
                            }
                            <td colspan="2" rowspan="3" class="muted" style="text-align:left;vertical-align:top"><a href="@PortfolioUi.CapabilitiesHref(cat, "cost")">Cost details →</a></td>
                        </tr>
                        <tr class="cost-row">
                            <td style="text-align:left"><b>One-time</b></td>
                            @foreach (var a in matrix.Apps)
                            {
                                var k = matrix.Cost(a.Id);
                                <td>@(k.IsPriced ? PortfolioUi.Money(k.OneTime) : "–")</td>
                            }
                        </tr>
                        <tr class="cost-row">
                            <td style="text-align:left"><b>First year</b></td>
                            @foreach (var a in matrix.Apps)
                            {
                                var k = matrix.Cost(a.Id);
                                <td>@(k.IsPriced ? (k.IsComplete ? "" : "≥ ") + PortfolioUi.Money(Math.Round(k.FirstYear)) : "–")</td>
                            }
                        </tr>
                    }
                </tfoot>
            </table>
        </div>
    }

    @if (pricing is { } pr)
    {
        <PricingLineEditor Draft="pr.Draft" AppName="@pr.App" OnClose="OnPriced" />
    }
    @if (editingProfile is { } ep)
    {
        <SiteProfileEditor Draft="ep" OnClose="OnProfileSaved" />
    }

    @if (rating is { } r)
    {
        <AssessmentEditor FeatureId="r.Feature.Id" ApplicationId="r.App.Id" AppName="@r.App.Name" FeatureName="@r.Feature.Name"
                          FeatureDescription="@r.Feature.Description" Current="matrix?.Cell(r.Feature.Id, r.App.Id)" OnClose="OnRated" />
    }
}

@code {
    [Parameter] public string CategoryName { get; set; } = "";
    /// <summary>matrix (default), heatmap, cost or features.</summary>
    [SupplyParameterFromQuery(Name = "view")] public string? ViewParam { get; set; }
    /// <summary>Comma-separated application ids the comparison is narrowed to (all when empty).</summary>
    [SupplyParameterFromQuery(Name = "apps")] public string? AppsParam { get; set; }

    private AppCategory? category;
    private CapabilityMatrix? matrix;
    private List<Application> others = [];
    private FeatureDraft? editingFeature;
    private int? deletingFeatureId;
    private string? newFeature, error;
    private int addAppId;
    private bool includeRetired, transpose, gapsOnly;
    private (CapabilityFeature Feature, MatrixApp App)? rating;
    private List<SiteProfile> profiles = [];
    /// <summary>The site profile costed for: a saved profile's id, 0 for "try your own site", -1 for the category default.</summary>
    private int profileId = -1;
    private SiteProfileDraft trial = new();
    private SiteProfileDraft? editingProfile;
    private (PricingLineDraft Draft, string App)? pricing;
    private AppCategory? loadedCategory;
    /// <summary>Applications ticked on the matrix, to compare.</summary>
    private readonly HashSet<int> picked = [];

    private string View => ViewParam is "heatmap" or "features" or "cost" ? ViewParam : "matrix";
    private string? ViewKey => View == "matrix" ? null : View;
    /// <summary>The applications the comparison is narrowed to, from the address (null: all).</summary>
    private IReadOnlyList<int>? Only => CapabilityMatrix.ParseIds(AppsParam);
    private string AppsQuery => matrix is { Narrowed: true } ? $"&apps={string.Join(",", matrix.Apps.Select(a => a.Id))}" : "";
    private List<int> Picked => matrix is null ? [] : matrix.Apps.Where(a => picked.Contains(a.Id)).Select(a => a.Id).ToList();
    private string ExportHref => $"/export/capabilities/{category}.xlsx?retired={includeRetired}" + (profileId > 0 ? $"&profile={profileId}" : "") + AppsQuery;
    private string Title => category is { } c ? PortfolioText.Label(c) : CategoryName;

    protected override async Task OnParametersSetAsync()
    {
        category = Enum.TryParse<AppCategory>(CategoryName, ignoreCase: true, out var c) && Enum.IsDefined(c) ? c : null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (category is not { } cat) return;
        if (loadedCategory != cat)
        {
            (loadedCategory, profileId, trial) = (cat, -1, new SiteProfileDraft { Category = cat, Name = "Your site" });
        }
        profiles = await Svc.GetSiteProfilesAsync(cat);
        if (profileId > 0 && profiles.All(p => p.Id != profileId)) profileId = -1;
        trial.Category = cat;
        matrix = await Svc.GetCapabilityMatrixAsync(cat, includeRetired, profileId > 0 ? profileId : null, profileId == 0 ? trial.ToProfile() : null,
            View == "features" ? null : Only);
        if (profileId < 0 && matrix.Site.Id > 0) profileId = matrix.Site.Id;
        var inMatrix = matrix.Apps.Select(a => a.Id).ToHashSet();
        others = (await Svc.GetApplicationsAsync())
            .Where(a => a.Category != cat && !inMatrix.Contains(a.Id) && a.Status != LifecycleStatus.Retired)
            .OrderBy(a => a.Name).ToList();
    }

    private async Task RunAsync(Func<Task> action)
    {
        error = null;
        try { await action(); }
        catch (InvalidOperationException ex) { error = ex.Message; }
        deletingFeatureId = null;
        await LoadAsync();
    }

    private async Task AddFeatureAsync()
    {
        if (category is not { } cat || string.IsNullOrWhiteSpace(newFeature)) return;
        var name = newFeature;
        await RunAsync(async () => { await Svc.SaveFeatureAsync(new FeatureDraft { Category = cat, Name = name }); newFeature = null; });
    }

    private async Task OnNewFeatureKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddFeatureAsync();
    }

    private async Task SaveFeatureAsync()
    {
        if (editingFeature is not { } d) return;
        await RunAsync(async () => { await Svc.SaveFeatureAsync(d); editingFeature = null; });
    }

    private async Task AddMemberAsync()
    {
        if (category is not { } cat || addAppId == 0) return;
        var id = addAppId;
        await RunAsync(() => Svc.AddComparisonMemberAsync(cat, id));
        addAppId = 0;
    }

    private async Task ToggleRetiredAsync()
    {
        includeRetired = !includeRetired;
        await LoadAsync();
    }

    private void Rate(CapabilityFeature f, MatrixApp a) => rating = (f, a);

    private void TogglePick(int appId)
    {
        if (!picked.Remove(appId)) picked.Add(appId);
    }

    /// <summary>Narrows the comparison to the ticked applications (in the address, so it can be bookmarked or shared).</summary>
    private void Compare()
    {
        if (category is not { } cat || Picked is not { Count: >= 2 } ids) return;
        picked.Clear();
        Nav.NavigateTo(PortfolioUi.CapabilitiesHref(cat, ViewKey, ids));
    }

    private async Task OnProfileChanged(ChangeEventArgs e)
    {
        profileId = int.TryParse(e.Value?.ToString(), out var id) ? id : -1;
        await LoadAsync();
    }

    private void NewProfile()
    {
        if (category is { } cat) editingProfile = new SiteProfileDraft { Category = cat, IsDefault = profiles.Count == 0 };
    }

    private void SaveTrialAsProfile()
    {
        if (category is not { } cat) return;
        editingProfile = new SiteProfileDraft
        {
            Category = cat, Name = "", Users = trial.Users, Licenses = trial.Licenses, DockDoors = trial.DockDoors, Assets = trial.Assets,
            TransactionsPerMonth = trial.TransactionsPerMonth, IsDefault = profiles.Count == 0,
        };
    }

    private async Task OnProfileSaved(int? id)
    {
        editingProfile = null;
        if (id is null) return;
        profileId = id > 0 ? id.Value : -1;
        await LoadAsync();
    }

    private async Task OnPriced(bool saved)
    {
        pricing = null;
        if (saved) await LoadAsync();
    }

    /// <summary>Applications for the cost table: fully costed by monthly cost, then incomplete, then not priced.</summary>
    private IEnumerable<MatrixApp> CostOrder() => matrix!.Apps
        .OrderBy(a => matrix.Cost(a.Id) switch { { IsComplete: true } => 0, { IsPriced: true } => 1, _ => 2 })
        .ThenBy(a => matrix.Cost(a.Id).Monthly).ThenBy(a => a.Name, StringComparer.OrdinalIgnoreCase);

    private async Task OnRated(bool saved)
    {
        rating = null;
        if (saved) await LoadAsync();
    }

    private static string CellTip(MatrixApp a, CapabilityFeature f, FeatureAssessment? c)
    {
        if (c is null) return $"{a.Name} – {f.Name}: not rated. Click to rate.";
        var parts = new List<string>();
        if (c.Availability is { } av) parts.Add($"Has it: {av}");
        if (c.Strength is { } st) parts.Add($"Strength: {st}");
        if (c.Note is { } n) parts.Add(n);
        return $"{a.Name} – {f.Name}: {string.Join(". ", parts)}";
    }
}
