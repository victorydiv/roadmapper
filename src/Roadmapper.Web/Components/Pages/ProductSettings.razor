@page "/products/{ProductId:int}/settings"
@inject PortfolioService Portfolio
@inherits ProductPageBase
@inject NavigationManager Nav

@if (Roadmap is null)
{
    if (Loaded) { <NotFoundCard /> }
}
else
{
    var product = Roadmap.Product;
    <ProductHeader Roadmap="Roadmap" Section="Settings" />

    @if (Error is not null)
    {
        <div class="alert" style="margin-bottom:.75rem">@Error</div>
    }

    <div class="settings">
        <div class="card stack">
            <h2>Product</h2>
            <label class="field">Name
                <input @bind="name" />
            </label>
            <label class="field">Description
                <textarea @bind="description"></textarea>
            </label>
            <label class="field">Prioritization model
                <select @bind="model">
                    <option value="@ScoringModel.Rice">RICE: (Reach × Impact × Confidence) ÷ Effort</option>
                    <option value="@ScoringModel.Wsjf">WSJF: Cost of delay ÷ Job size</option>
                    <option value="@ScoringModel.Moscow">MoSCoW: Must / Should / Could / Won't</option>
                </select>
            </label>
            @if (model != product.ScoringModel)
            {
                <div class="alert warn small">
                    Scores will be recalculated with @Ui.Label(model). Inputs entered for other models are kept,
                    so you can switch back without losing them.
                </div>
            }
            <div class="row">
                <button class="btn primary" @onclick="SaveProductAsync">Save</button>
                @if (saved)
                {
                    <span class="muted small">Saved ✓</span>
                }
            </div>
        </div>

        <div class="card stack">
            <h2>Themes</h2>
            <div class="muted small">Themes group work across the hierarchy and color the timeline bars.</div>
            <div class="chip-list">
                @foreach (var theme in product.Themes)
                {
                    <span class="chip">
                        <span class="theme-dot" style="background:@theme.Color"></span>@theme.Name
                        <button class="btn icon sm" title="Delete theme" @onclick="() => RunAsync(() => Svc.DeleteThemeAsync(theme.Id))">✕</button>
                    </span>
                }
                @if (product.Themes.Count == 0)
                {
                    <span class="muted small">No themes yet.</span>
                }
            </div>
            <div class="row">
                <input type="color" @bind="newThemeColor" />
                <input placeholder="New theme name" @bind="newTheme" @bind:event="oninput" style="flex:1;width:auto" />
                <button class="btn" disabled="@string.IsNullOrWhiteSpace(newTheme)" @onclick="AddThemeAsync">Add</button>
            </div>
        </div>

        <div class="card stack">
            <h2>Tags</h2>
            <div class="chip-list">
                @foreach (var tag in product.Tags)
                {
                    <span class="chip">
                        #@tag.Name
                        <button class="btn icon sm" title="Delete tag" @onclick="() => RunAsync(() => Svc.DeleteTagAsync(tag.Id))">✕</button>
                    </span>
                }
                @if (product.Tags.Count == 0)
                {
                    <span class="muted small">No tags yet.</span>
                }
            </div>
            <div class="row">
                <input placeholder="New tag" @bind="newTag" @bind:event="oninput" style="flex:1;width:auto" />
                <button class="btn" disabled="@string.IsNullOrWhiteSpace(newTag)" @onclick="AddTagAsync">Add</button>
            </div>
        </div>

        <div class="card stack templates-card">
            <div class="row">
                <h2 style="margin:0">Task templates</h2>
                <span class="spacer"></span>
                <button class="btn primary" @onclick="NewTemplate">+ New template</button>
            </div>
            <div class="muted small">
                Reusable sets of tasks. Use "Add from template" on a Feature to create them all at once.
                Tasks are copied: editing or deleting a template never changes tasks already created from it.
            </div>
            @if (templates.Count == 0)
            {
                <span class="muted small">No templates yet.</span>
            }
            <ul class="template-list">
                @foreach (var t in templates)
                {
                    <li @key="t.Id">
                        <div class="stack" style="gap:.1rem;flex:1;min-width:0">
                            <b>@t.Name</b>
                            <span class="muted small">
                                @t.Lines.Count task@(t.Lines.Count == 1 ? "" : "s"): @string.Join(" · ", t.Lines.Take(4).Select(l => l.Title))@(t.Lines.Count > 4 ? " …" : "")
                            </span>
                            @if (t.Description is { } d)
                            {
                                <span class="muted small">@d</span>
                            }
                        </div>
                        @if (deletingTemplateId == t.Id)
                        {
                            <span class="small">Delete “@t.Name”? Tasks already created from it are kept.</span>
                            <button class="btn danger sm" @onclick="() => DeleteTemplateAsync(t.Id)">Delete</button>
                            <button class="btn sm" @onclick="() => deletingTemplateId = null">Keep</button>
                        }
                        else
                        {
                            <button class="btn sm" @onclick="() => editingTemplate = TemplateDraft.From(t)">Edit</button>
                            <button class="btn sm" @onclick="() => TemplateActionAsync(() => Svc.DuplicateTemplateAsync(t.Id))">Duplicate</button>
                            <button class="btn sm danger" @onclick="() => deletingTemplateId = t.Id">Delete…</button>
                        }
                    </li>
                }
            </ul>
        </div>

        <div class="card stack rubric-card">
            <div class="row">
                <h2 style="margin:0">WSJF scoring rubric</h2>
                <span class="spacer"></span>
                @if (rubric.IsEmpty)
                {
                    <button class="btn" @onclick="() => RubricActionAsync(() => Svc.AddStarterRubricAsync(ProductId))">Start from example</button>
                }
                <button class="btn primary" @onclick="NewCriterion">+ New criterion</button>
            </div>
            <div class="muted small">
                Work out Business value, Time criticality, Risk reduction and Job size from answers instead of typing them.
                Answer the criteria in the item editor or on the <a href="/products/@ProductId/scoring">Scoring</a> tab.
                Values already typed by hand are kept; switch a factor to the rubric on the item when you're ready.
            </div>
            @if (product.ScoringModel != ScoringModel.Wsjf)
            {
                <div class="alert warn small">This product uses @Ui.Label(product.ScoringModel). The rubric only calculates scores when the model is WSJF.</div>
            }
            <div class="row">
                <label class="field" style="flex:1">Scale (scores move along it; adjusters move one value per step)
                    <input @bind="scaleText" placeholder="@RubricScale.Format(RubricScale.Default)" />
                </label>
                <button class="btn" style="align-self:flex-end" @onclick="() => RubricActionAsync(() => Svc.SetScaleAsync(ProductId, scaleText))">Save scale</button>
            </div>
            @if (rubric.IsEmpty)
            {
                <span class="muted small">No criteria yet. “Start from example” adds a simple rubric you can edit.</span>
            }
            <div class="rubric-groups">
            @foreach (var factor in RubricCalculator.Factors)
            {
                var criteria = rubric.ForFactor(factor).ToList();
                if (criteria.Count == 0) continue;
                <div class="rubric-group">
                    <b>@RubricText.Factor(factor)</b>
                    <ul class="template-list">
                        @for (var i = 0; i < criteria.Count; i++)
                        {
                            var c = criteria[i];
                            var first = i == 0;
                            var last = i == criteria.Count - 1;
                            <li @key="c.Id">
                                <div class="stack" style="gap:.1rem;flex:1;min-width:0">
                                    <span>
                                        <b>@c.Name</b>
                                        <span class="badge tag">@(c.Role == CriterionRole.Base ? "sets score" : "adjuster")</span>
                                        <span class="muted small">@RubricText.Kind(c.Kind)</span>
                                    </span>
                                    <span class="muted small">@OptionSummary(c)</span>
                                </div>
                                @if (deletingCriterionId == c.Id)
                                {
                                    <span class="small">Delete “@c.Name” and every answer to it?</span>
                                    <button class="btn danger sm" @onclick="() => DeleteCriterionAsync(c.Id)">Delete</button>
                                    <button class="btn sm" @onclick="() => deletingCriterionId = null">Keep</button>
                                }
                                else
                                {
                                    <button class="btn icon" title="Move up" disabled="@first" @onclick="() => RubricActionAsync(() => Svc.MoveCriterionAsync(c.Id, -1))">↑</button>
                                    <button class="btn icon" title="Move down" disabled="@last" @onclick="() => RubricActionAsync(() => Svc.MoveCriterionAsync(c.Id, 1))">↓</button>
                                    <button class="btn sm" @onclick="() => editingCriterion = RubricRules.Copy(c)">Edit</button>
                                    <button class="btn sm danger" @onclick="() => deletingCriterionId = c.Id">Delete…</button>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }
            </div>
        </div>

        <div class="card stack">
            <h2>Danger zone</h2>
            <div class="muted small">Deleting a product removes its whole roadmap: @Roadmap.Items.Count items, themes, tags and dependencies@(benefitCount > 0 ? $", and the {benefitCount} benefit{(benefitCount == 1 ? "" : "s")} its items carry in the portfolio" : "").</div>
            @if (confirmingDelete)
            {
                <label class="field">Type the product name to confirm
                    <input @bind="confirmName" @bind:event="oninput" />
                </label>
                <div class="row">
                    <button class="btn danger" disabled="@(confirmName != product.Name)" @onclick="DeleteProductAsync">Delete permanently</button>
                    <button class="btn" @onclick="() => confirmingDelete = false">Cancel</button>
                </div>
            }
            else
            {
                <div><button class="btn danger" @onclick="() => confirmingDelete = true">Delete product…</button></div>
            }
        </div>
    </div>

    @if (editingCriterion is not null)
    {
        <RubricEditor Draft="editingCriterion" Scale="rubric.Scale" OnClose="OnCriterionEditorClosed" />
    }

    @if (editingTemplate is not null)
    {
        <TemplateEditor Roadmap="Roadmap" Draft="editingTemplate" OnClose="OnTemplateEditorClosed" />
    }
}

@code {
    private string name = "";
    private string? description;
    private ScoringModel model;
    private bool saved, confirmingDelete;
    private int benefitCount;
    private string? newTheme, newTag, confirmName;
    private string newThemeColor = "#4f7cff";
    private List<TaskTemplate> templates = [];
    private TemplateDraft? editingTemplate;
    private int? deletingTemplateId;
    private ScoringRubric rubric = ScoringRubric.Empty;
    private ScoringCriterion? editingCriterion;
    private int? deletingCriterionId;
    private string? scaleText;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        benefitCount = await Portfolio.CountBenefitsForProductAsync(ProductId);
        templates = await Svc.GetTemplatesAsync(ProductId);
        LoadRubric();
        if (Roadmap is { Product: var p })
        {
            name = p.Name;
            description = p.Description;
            model = p.ScoringModel;
        }
    }

    private async Task SaveProductAsync()
    {
        saved = false;
        await RunAsync(() => Svc.UpdateProductAsync(ProductId, name, description, model));
        saved = Error is null;
    }

    private async Task AddThemeAsync()
    {
        await RunAsync(() => Svc.AddThemeAsync(ProductId, newTheme!, newThemeColor));
        if (Error is null) newTheme = null;
    }

    private async Task AddTagAsync()
    {
        await RunAsync(() => Svc.AddTagAsync(ProductId, newTag!));
        if (Error is null) newTag = null;
    }

    private void NewTemplate() =>
        editingTemplate = new TemplateDraft { ProductId = ProductId, Lines = [new TemplateLineDraft()] };

    private async Task OnTemplateEditorClosed(bool saved)
    {
        editingTemplate = null;
        if (saved) templates = await Svc.GetTemplatesAsync(ProductId);
    }

    private async Task DeleteTemplateAsync(int id)
    {
        deletingTemplateId = null;
        await TemplateActionAsync(() => Svc.DeleteTemplateAsync(id));
    }

    private async Task TemplateActionAsync(Func<Task> action)
    {
        await RunAsync(action);
        templates = await Svc.GetTemplatesAsync(ProductId);
    }

    private void LoadRubric()
    {
        rubric = Roadmap?.Rubric ?? ScoringRubric.Empty;
        scaleText = RubricScale.Format(rubric.Scale);
    }

    private void NewCriterion() => editingCriterion = new ScoringCriterion
    {
        ProductId = ProductId,
        Kind = CriterionKind.Choice,
        Options = [new ScoringCriterionOption { Value = rubric.Scale[0] }],
    };

    private async Task OnCriterionEditorClosed(bool saved)
    {
        editingCriterion = null;
        if (saved) await RubricActionAsync(() => Task.CompletedTask);
    }

    private async Task DeleteCriterionAsync(int id)
    {
        deletingCriterionId = null;
        await RubricActionAsync(() => Svc.DeleteCriterionAsync(id));
    }

    private async Task RubricActionAsync(Func<Task> action)
    {
        await RunAsync(action);
        if (Error is null) LoadRubric();
    }

    private static string OptionSummary(ScoringCriterion c)
    {
        string Value(double v) => c.Role == CriterionRole.Base ? RubricText.Number(v) : RubricText.Steps(v);
        var options = c.Kind == CriterionKind.Choice
            ? c.Options.Select(o => $"{o.Label} {Value(o.Value)}")
            : c.Options.OrderBy(o => o.From).Select(o => $"from {RubricText.Number(o.From ?? 0)}{(c.Kind == CriterionKind.StartDate ? " mo" : "")} → {Value(o.Value)}");
        return string.Join(" · ", options);
    }

    private async Task DeleteProductAsync()
    {
        await Svc.DeleteProductAsync(ProductId);
        Nav.NavigateTo("/");
    }
}
